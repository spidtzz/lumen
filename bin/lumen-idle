#!/usr/bin/env python3
"""lumen-idle: put the computer to sleep after "Sleep after" (Settings > Power).

Counts from the last key press or mouse movement (X's idle time). It doesn't
suspend while:
  - Keep awake is on (quick settings),
  - sound is playing (a video or music with no input for a while),
  - an app asks the system to stay up (an idle or sleep inhibitor: video
    players, downloads, updates; see `systemd-inhibit --list`).
It tries again once you've been back and idle for the full time again.

Started by bspwmrc, one per X session:
    lumen-idle          watch
    lumen-idle --status print the idle time and what would stop a suspend
"""
import os
import subprocess
import sys
import time

from Xlib import display

CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                    "lumen", "settings.conf")
AWAKE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "lumen-awake")


def sleep_after():
    """Minutes, 0 = never."""
    try:
        with open(CONF) as f:
            for line in f:
                if line.startswith("sleep_after="):
                    v = line.split("=", 1)[1].strip()
                    return int(v) if v.isdigit() else 0
    except OSError:
        pass
    return 0


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def sound_playing():
    # pipewire-pulse / pulseaudio: a playing stream is "RUNNING".
    return "RUNNING" in run(["pactl", "list", "short", "sinks"])


def inhibited():
    """An app holding an idle or sleep inhibitor in block mode."""
    out = run(["systemd-inhibit", "--list", "--no-legend", "--no-pager"])
    # WHO UID USER PID COMM WHAT WHY... MODE
    for line in out.splitlines():
        f = line.split()
        if len(f) < 7 or f[-1] != "block":
            continue
        if {"idle", "sleep"} & set(f[5].split(":")):
            return "%s (%s)" % (f[0], f[4])
    return ""


def reasons():
    why = []
    if os.path.exists(AWAKE):
        why.append("Keep awake is on")
    if sound_playing():
        why.append("sound is playing")
    inh = inhibited()
    if inh:
        why.append("an app asks to stay up: " + inh)
    return why


def main():
    d = display.Display()
    root = d.screen().root

    def idle_s():
        return root.screensaver_query_info().idle / 1000

    if "--status" in sys.argv:
        print("idle %.0f s, sleep after %d min" % (idle_s(), sleep_after()))
        for r in reasons() or ["nothing would stop it"]:
            print(" -", r)
        return 0

    slept = False   # once per idle stretch: waking up isn't input
    while True:
        mins = sleep_after()
        idle = idle_s()
        if idle < 30:
            slept = False
        if mins > 0 and not slept and idle >= mins * 60 and not reasons():
            slept = True
            subprocess.run(["systemctl", "suspend"])
        # Check often enough near the time, rarely otherwise.
        wait = 30 if mins == 0 else max(5, min(30, mins * 60 - idle))
        time.sleep(wait)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)

#!/usr/bin/env bash
# lumen-doctor — check the parts lumen depends on and print what's wrong.
# Paste its output into a bug report. Nothing is changed.
#   lumen doctor            everything
#   lumen doctor keyboard   layout switching, step by step (switches the
#                           layout once and back, and asks you to press keys)
set -u

ok() { printf '  \e[32mok\e[0m    %s\n' "$*"; }
bad() { printf '  \e[31mfail\e[0m  %s\n' "$*"; }
note() { printf '  \e[33m--\e[0m    %s\n' "$*"; }
has() { command -v "$1" >/dev/null 2>&1; }
head_() { printf '\n%s\n' "$*"; }

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/lumen/settings.conf
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/lumen

# lumen doctor keyboard: step-by-step check of layout switching.
if [[ ${1:-} == keyboard ]]; then
	setting() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -n 1; }
	layouts=$(setting kb_layouts) switch=$(setting kb_switch)
	head_ "1. Settings"
	note "layouts in Settings: ${layouts:-us (default)} · switch keys: ${switch:-alt_shift (default)}"
	now=$(setxkbmap -query 2>/dev/null | sed -n 's/^layout:[[:space:]]*//p')
	note "layouts X has now: ${now:-?}   (the first one is the active one)"
	[[ $now == *,* ]] && ok "more than one layout, so there's something to switch to" ||
		bad "only one layout: add another in Settings > Keyboard & Mouse"
	note "XKB options: $(setxkbmap -query 2>/dev/null | sed -n 's/^options:[[:space:]]*//p')"

	head_ "2. Switching by command (no keys involved)"
	before=$now
	lumen-settings layout-hotkey "${switch:-alt_shift}"
	sleep 0.3
	after=$(setxkbmap -query 2>/dev/null | sed -n 's/^layout:[[:space:]]*//p')
	if [[ $after != "$before" ]]; then
		ok "switched: $before -> $after"
		lumen-settings layout-hotkey "${switch:-alt_shift}"   # and back
		[[ $after == *,*,* ]] && note "(with three or more layouts it's now on the next one; that's fine)"
	else
		bad "the layout didn't change ($before)"
	fi

	head_ "3. The watcher"
	pgrep -af 'lumen-settings kbswitch$' | sed 's/^/          /'
	pgrep -af 'lumen-[k]bswitch' | sed 's/^/          /'
	pgrep -f 'lumen-[k]bswitch' >/dev/null && ok "running" || bad "not running"
	note "mode file: $(cat "$STATE/kbswitch-mode" 2>/dev/null || echo none)"
	[[ -s $STATE/kbswitch.log ]] && { note "log:"; tail -n 8 "$STATE/kbswitch.log" | sed 's/^/          /'; }

	head_ "4. Live (10 seconds)"
	printf '        Press and release Alt+Shift two or three times, then type a few letters.\n'
	printf '        Each "SWITCH" line should change the layout on the bar.\n\n'
	# Stop the normal watcher meanwhile (two would switch twice), restart it after.
	pkill -f 'lumen-settings kbswitch$' 2>/dev/null
	pkill -f 'lumen-[k]bswitch' 2>/dev/null
	timeout 10 lumen-kbswitch --debug 2>&1 | sed 's/^/          /'
	lumen-settings kbswitch-start
	echo
	exit 0
fi

head_ "System"
note "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}") · $(uname -r)"
note "session: ${XDG_SESSION_TYPE:-?} · DISPLAY=${DISPLAY:-unset} · WM: $(pgrep -x bspwm >/dev/null && echo bspwm || echo 'bspwm not running')"
has pacman && note "$(pacman -Q quickshell qt6-base picom 2>&1 | tr '\n' ' ')"

head_ "Shell (Quickshell)"
if ! has qs; then
	bad "qs isn't installed"
else
	v=$(qs --version 2>&1)
	if [[ $v == *"symbol lookup error"* ]]; then
		bad "Quickshell doesn't match the installed Qt: $v"
	else
		ok "$v"
	fi
	if pgrep -f 'qs -c lumen|quickshell -c lumen' >/dev/null; then ok "the shell is running"; else bad "the shell isn't running (lumen reload)"; fi
	if qs -c lumen ipc call panels close >/dev/null 2>&1; then ok "the shell answers commands"; else bad "the shell doesn't answer 'qs -c lumen ipc call'"; fi
fi
if [[ -f $STATE/quickshell.log ]] && m=$(grep -m 1 'was built against Qt' "$STATE/quickshell.log"); then
	bad "Quickshell needs rebuilding for the installed Qt (it may crash): ${m#*WARN: }"
fi
[[ -f $STATE/quickshell.log ]] && {
	n=$(grep -ciE 'error|warn' "$STATE/quickshell.log")
	note "$n warnings/errors in $STATE/quickshell.log; the last ones:"
	grep -iE 'error|warn' "$STATE/quickshell.log" | tail -n 5 | sed 's/^/          /'
}

head_ "Input (Alt+Shift layout switching; clicks that close bar popups)"
python3 -c 'import Xlib' 2>/dev/null && ok "python-xlib installed" || bad "python-xlib isn't installed"
pgrep -f 'lumen-settings [k]bswitch' >/dev/null && ok "watcher loop running (lumen-settings kbswitch)" || bad "watcher loop not running (bspwm or the shell starts it: lumen-settings kbswitch)"
if pgrep -f 'lumen-[k]bswitch' >/dev/null; then
	mode=$(pgrep -af 'lumen-[k]bswitch' | grep -q -- '--poll' && echo "checking keys 50 times a second" || echo "X RECORD events")
	ok "layout switch watcher running ($mode)"
else
	bad "the key watcher (lumen-kbswitch) isn't running"
fi
[[ -s $STATE/kbswitch.log ]] && { note "last lines of $STATE/kbswitch.log:"; tail -n 6 "$STATE/kbswitch.log" | sed 's/^/          /'; }
if [[ -t 0 ]] && command -v lumen-kbswitch >/dev/null; then
	printf '        Press a few keys within 6 seconds...\n'
	n=$(lumen-kbswitch --test 2>/dev/null </dev/null | grep -c '^key')
	((n > 0)) && ok "key presses seen ($n)" || bad "no key presses seen: Alt+Shift switching won't work"
fi

head_ "Compositor"
if [[ $(sed -n 's/^compositor=//p' "$CONF" 2>/dev/null) == false ]]; then
	note "turned off in Settings"
elif pgrep -x picom >/dev/null; then
	ok "picom running: $(tr '\0' ' ' </proc/"$(pgrep -x picom | head -n 1)"/cmdline)"
else
	bad "picom isn't running (see $STATE/picom.log)"
fi

head_ "Cursor"
note "XCURSOR_THEME=${XCURSOR_THEME:-unset} XCURSOR_SIZE=${XCURSOR_SIZE:-unset}"
for f in "$HOME/.icons/default/index.theme" "${XDG_DATA_HOME:-$HOME/.local/share}/icons/default/index.theme" /usr/share/icons/default/index.theme; do
	[[ -f $f ]] && note "$f: $(grep -m 1 '^Inherits' "$f")"
done
if has xrdb; then
	xt=$(xrdb -query 2>/dev/null | sed -n 's/^Xcursor.theme:[[:space:]]*//p')
	[[ -z $xt || $xt == Adwaita ]] && ok "X resources cursor: ${xt:-not set}" || bad "X resources set the cursor theme to '$xt' (log out and in again; lumen sets Adwaita)"
fi

head_ "Login screen"
dm=$(basename "$(readlink /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null)
[[ $dm == sddm.service ]] && ok "SDDM is the login manager" || bad "the login manager is '${dm:-none}', not SDDM"
[[ -f /usr/share/sddm/themes/lumen/Main.qml ]] && ok "lumen theme installed" || bad "lumen SDDM theme missing (/usr/share/sddm/themes/lumen)"
for f in /usr/lib/sddm/sddm.conf.d/*.conf /etc/sddm.conf.d/*.conf /etc/sddm.conf; do
	[[ -f $f ]] || continue
	c=$(grep -E '^[[:space:]]*Current=' "$f" | tail -n 1)
	[[ -n $c ]] && note "$f: ${c// /}"
done
note "SDDM uses the last of these (/etc/sddm.conf wins over the folders)"

head_ "Displays"
has xrandr && note "$(xrandr --query 2>/dev/null | grep -c ' connected') connected screen(s)" || bad "xrandr isn't installed"
echo

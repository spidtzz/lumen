#!/usr/bin/env bash
# lumen-capture — screenshots and screen recordings.
#
# Usage:
#   lumen-capture shot   [screen|window|selection] [options]
#   lumen-capture record [screen|window|selection] [options]
#   lumen-capture stop             stop the recording
#   lumen-capture toggle [target]  start recording, or stop if one is running
#   lumen-capture status           "recording <start-epoch> <file>" or "idle"
#   lumen-capture freeze           (for the capture overlay) picture of the
#                                  screen now, the monitor and the windows, as JSON
#
# Options:
#   --geometry WxH+X+Y   this part of the screen (instead of the target)
#   --window ID          this window (X window id)
#   --monitor NAME       this monitor
#   --delay N            wait N seconds first
#   --pointer | --no-pointer      include the mouse pointer
#   --copy | --save      screenshot to the clipboard only, or saved as well
#   --audio              record what the speakers play
#
# Without options, --pointer and --copy/--save follow the capture overlay's
# options (super + shift + s or Print; it remembers them). Screenshots always
# go to the clipboard, and are also saved to ~/Pictures/Screenshots unless
# "copy only" is chosen; recordings go to ~/Videos/Captures. "window" is the focused window, "selection"
# lets you drag a rectangle or click a window. Uses maim, slop, xclip and
# gpu-screen-recorder, which falls back to CPU encoding (e.g. in a VM).
set -uo pipefail

PICS=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
VIDS=$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Captures
RUNDIR=${XDG_RUNTIME_DIR:-/tmp}
RUN=$RUNDIR/lumen-recording
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/lumen/recording.log
SETTINGS=${XDG_CONFIG_HOME:-$HOME/.config}/lumen/settings.conf

die() { printf 'lumen-capture: %s\n' "$*" >&2; notify-send -a lumen -u low "Capture" "$*" 2>/dev/null; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }
stamp() { date +%Y-%m-%d_%H-%M-%S; }
# A file name that doesn't exist yet: name.ext, name-2.ext, ...
unique() {
	local base=$1 ext=$2 n=2 f="$1.$2"
	while [[ -e $f ]]; do f="$base-$n.$ext"; n=$((n + 1)); done
	printf '%s' "$f"
}
notify_shell() { has qs && { qs -c lumen ipc call capture changed >/dev/null 2>&1 & } || true; }
setting() { # setting key default
	local v
	v=$(sed -n "s/^$1=//p" "$SETTINGS" 2>/dev/null | tail -n 1)
	printf '%s' "${v:-$2}"
}

# Focused window id (bspwm node ids are X window ids), as decimal.
focused_window() {
	local id
	id=$(bspc query -N -n focused.window 2>/dev/null) || return 1
	[[ -n $id ]] && printf '%d' "$id"
}

# Region WxH+X+Y chosen with the mouse (drag, or click a window).
select_region() {
	has slop || die "slop is not installed"
	slop -f '%wx%h+%x+%y' -b 2 -l -c 0.45,0.64,1,0.18 2>/dev/null
}

# Geometry of a monitor by name (bspwm), as WxH+X+Y.
monitor_geometry() {
	bspc query -T -m "$1" 2>/dev/null | python3 -c '
import json, sys
r = json.load(sys.stdin)["rectangle"]
print("%dx%d+%d+%d" % (r["width"], r["height"], r["x"], r["y"]))' 2>/dev/null
}

recording() { [[ -f $RUN ]] && kill -0 "$(cut -d' ' -f1 "$RUN")" 2>/dev/null; }

# Shared option parsing: sets target, geometry, window, monitor, delay,
# pointer, copy, audio.
parse() {
	target=screen geometry="" window="" monitor="" delay=0 audio=0
	pointer=$(setting capture_pointer false)
	[[ $(setting capture_save true) == true ]] && copy=0 || copy=1
	while (($#)); do
		case $1 in
			screen | window | selection | area) target=$1 ;;
			--geometry) geometry=${2:-}; shift ;;
			--window) window=${2:-}; shift ;;
			--monitor) monitor=${2:-}; shift ;;
			--delay) delay=${2:-0}; shift ;;
			--pointer | --cursor) pointer=true ;;
			--no-pointer | --no-cursor) pointer=false ;;
			--copy) copy=1 ;;
			--save | --no-copy) copy=0 ;;
			--audio) audio=1 ;;
			*) die "unknown option: $1" ;;
		esac
		shift
	done
	[[ $target == area ]] && target=selection
	[[ $delay =~ ^[0-9]+$ ]] || die "invalid delay"
	[[ -z $geometry || $geometry =~ ^[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$ ]] || die "invalid geometry: $geometry"
	[[ -z $window || $window =~ ^(0x[0-9a-fA-F]+|[0-9]+)$ ]] || die "invalid window id: $window"
	[[ -z $monitor || $monitor =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid monitor: $monitor"
	return 0
}

shot() {
	local target geometry window monitor delay pointer copy audio file args=()
	parse "$@"
	has maim || die "maim is not installed"

	if [[ -n $geometry ]]; then
		args+=(-g "$geometry")
	elif [[ -n $window ]]; then
		args+=(-i "$window")
	elif [[ -n $monitor ]]; then
		local g; g=$(monitor_geometry "$monitor") || die "unknown monitor: $monitor"
		args+=(-g "$g")
	else
		case $target in
			screen) ;;
			window) local w; w=$(focused_window) || die "no focused window"; args+=(-i "$w") ;;
			selection) local r; r=$(select_region) || exit 0; [[ -n $r ]] || exit 0; args+=(-g "$r") ;;
		esac
	fi
	[[ $pointer == true ]] || args+=(-u)

	# Always to the clipboard; also kept in Pictures/Screenshots unless --copy.
	if ((copy)); then
		has xclip || die "xclip is not installed"
		file=$RUNDIR/lumen-screenshot.png
	else
		mkdir -p "$PICS"
		file=$(unique "$PICS/Screenshot_$(stamp)" png)
	fi

	sleep 0.25 # let the capture overlay disappear
	((delay > 0)) && sleep "$delay"
	maim "${args[@]}" "$file" 2>/dev/null || die "screenshot failed"
	has xclip && xclip -selection clipboard -t image/png -i "$file"
	if ((copy)); then
		notify-send -a lumen -i "$file" "Screenshot copied" "Paste it with ctrl + v" 2>/dev/null
	else
		notify-send -a lumen -i "$file" "Screenshot saved and copied" "${file/#$HOME/\~}" 2>/dev/null
		printf '%s\n' "$file"
	fi
}

record() {
	local target geometry window monitor delay pointer copy audio file wargs=()
	parse "$@"
	recording && die "already recording (lumen-capture stop)"
	has gpu-screen-recorder || die "gpu-screen-recorder is not installed"
	mkdir -p "$VIDS" "$(dirname "$LOG")"
	file=$(unique "$VIDS/Recording_$(stamp)" mp4)

	even() { # WxH+X+Y with even width and height (encoders need them)
		local w=${1%%x*} rest=${1#*x}
		local h=${rest%%+*} pos=${rest#*+}
		printf '%dx%d+%s' "$((w / 2 * 2))" "$((h / 2 * 2))" "$pos"
	}
	if [[ -n $geometry ]]; then
		wargs=(-w region -region "$(even "$geometry")")
	elif [[ -n $window ]]; then
		wargs=(-w "$((window))")
	elif [[ -n $monitor ]]; then
		wargs=(-w "$monitor")
	else
		case $target in
			screen) wargs=(-w screen) ;;
			window) wargs=(-w focused) ;;
			selection)
				local r; r=$(select_region) || exit 0; [[ -n $r ]] || exit 0
				wargs=(-w region -region "$(even "$r")")
				;;
		esac
	fi

	sleep 0.25
	((delay > 0)) && sleep "$delay"
	local cursor=no
	[[ $pointer == true ]] && cursor=yes
	local cmd=(gpu-screen-recorder "${wargs[@]}" -f 60 -cursor "$cursor" -fallback-cpu-encoding yes -o "$file")
	((audio)) && cmd+=(-a default_output)
	"${cmd[@]}" >"$LOG" 2>&1 &
	local pid=$!
	sleep 0.6
	kill -0 "$pid" 2>/dev/null || die "recording failed to start (see ${LOG/#$HOME/\~})"
	printf '%s %s %s\n' "$pid" "$(date +%s)" "$file" >"$RUN"
	notify_shell
}

stop() {
	recording || { rm -f "$RUN"; notify_shell; return 0; }
	local pid start file
	read -r pid start file <"$RUN"
	kill -INT "$pid" 2>/dev/null
	for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
	rm -f "$RUN"
	notify_shell
	notify-send -a lumen "Recording saved" "${file/#$HOME/\~}" 2>/dev/null
	printf '%s\n' "$file"
}

# A still picture of the whole screen for the capture overlay to show (so
# menus and tooltips stay as they were), plus the focused monitor and the
# windows on it, topmost last.
freeze() {
	has maim || die "maim is not installed"
	local dir=$RUNDIR/lumen-capture file
	mkdir -p "$dir"
	rm -f "$dir"/frozen-*.png
	file=$dir/frozen-$(date +%s%N).png
	maim -u -m 1 "$file" 2>/dev/null || die "could not take a picture of the screen"
	python3 - "$file" <<'PY'
import json, subprocess, sys
from Xlib import X, display, error

image = sys.argv[1]
d = display.Display()
root = d.screen().root
rg = root.get_geometry()

def bspc(*a):
    try:
        return subprocess.run(["bspc", *a], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""

monitor = {"name": "", "x": 0, "y": 0, "w": rg.width, "h": rg.height}
try:
    m = json.loads(bspc("query", "-T", "-m", "focused"))
    r = m["rectangle"]
    monitor = {"name": m["name"], "x": r["x"], "y": r["y"], "w": r["width"], "h": r["height"]}
except (ValueError, KeyError):
    pass

focused = 0
try:
    focused = int(bspc("query", "-N", "-n", "focused.window").strip(), 16)
except ValueError:
    pass

windows = []
prop = root.get_full_property(d.intern_atom("_NET_CLIENT_LIST_STACKING"), X.AnyPropertyType)
for wid in (prop.value if prop else []):
    w = d.create_resource_object("window", wid)
    try:
        if w.get_attributes().map_state != X.IsViewable:
            continue
        g = w.get_geometry()
        t = root.translate_coords(w, 0, 0)
        cls = w.get_wm_class()
    except error.XError:
        continue
    windows.append({"id": wid, "x": t.x, "y": t.y, "w": g.width, "h": g.height,
                    "name": cls[1] if cls else ""})

print(json.dumps({"image": image, "monitor": monitor, "windows": windows, "focused": focused}))
PY
}

case ${1:-} in
	shot) shift; shot "$@" ;;
	record) shift; record "$@" ;;
	stop) stop ;;
	toggle) shift; if recording; then stop; else record "$@"; fi ;;
	freeze) freeze ;;
	status)
		if recording; then
			read -r _ start file <"$RUN"
			printf 'recording %s %s\n' "$start" "$file"
		else
			rm -f "$RUN"
			echo idle
		fi
		;;
	*) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; [[ -z ${1:-} || $1 == -h || $1 == --help ]] ;;
esac

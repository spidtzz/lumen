#!/usr/bin/env python3
"""lumen-thumbs: list wallpapers and make small thumbnails of them.

    lumen-thumbs CACHE FOLDER [--subfolders]

Prints one line per picture, in your Wallpapers FOLDER (with --subfolders,
also the folders inside it) and in the system wallpaper folders:

    f <TAB> user|system <TAB> path <TAB> group <TAB> thumbnail

then "listed", then "t <TAB> thumbnail" as each missing thumbnail is made
(at most 384 pixels wide, in CACHE, named after the path and modification
time so a changed picture gets a new one) or "x <TAB> thumbnail" when one
can't be made. Uses gdk-pixbuf-thumbnailer (GTK), else ffmpeg, else
ImageMagick; errors go to stderr. The Settings
Wallpaper page runs this.
"""
import hashlib
import os
import shutil
import signal
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

EXTS = (".jpg", ".jpeg", ".png", ".webp")
SYSTEM = ("/usr/share/backgrounds", "/usr/share/wallpapers")


def pictures(root, deep, limit):
    out = []
    if not os.path.isdir(root):
        return out
    for dirpath, dirnames, files in os.walk(root, followlinks=True):
        dirnames.sort()
        if not deep and dirpath != root:
            continue
        for f in sorted(files):
            if f.lower().endswith(EXTS) and "~" not in f:
                out.append(os.path.join(dirpath, f))
                if len(out) >= limit:
                    return out
        if not deep:
            dirnames[:] = []
    return out


def main():
    cache, folder = sys.argv[1], sys.argv[2]
    deep = "--subfolders" in sys.argv
    os.makedirs(folder, exist_ok=True)
    os.makedirs(cache, exist_ok=True)
    # The first version's thumbnails (some came out black).
    shutil.rmtree(os.path.join(os.path.dirname(cache), "wallpaper-thumbs"), ignore_errors=True)

    todo = []
    sets = [("user", folder, pictures(folder, deep, 500))]
    sets += [("system", root, pictures(root, True, 80)) for root in SYSTEM]
    for kind, root, files in sets:
        for path in files:
            try:
                mtime = os.stat(path).st_mtime
            except OSError:
                continue
            key = hashlib.md5(("%s|%s" % (path, mtime)).encode()).hexdigest()
            thumb = os.path.join(cache, key + ".png")
            rel = os.path.relpath(os.path.dirname(path), root) if kind == "user" else ""
            group = "" if rel == "." else rel
            print("f\t%s\t%s\t%s\t%s" % (kind, path, group, thumb if os.path.exists(thumb) else ""), flush=True)
            if not os.path.exists(thumb):
                todo.append((path, thumb))
    print("listed", flush=True)

    # Thumbnail makers, first one that works: GTK's, ffmpeg (mpv brings it),
    # ImageMagick.
    makers = []
    if shutil.which("gdk-pixbuf-thumbnailer"):
        makers.append(lambda src, dst: ["gdk-pixbuf-thumbnailer", "-s", "384", src, dst])
    if shutil.which("ffmpeg"):
        makers.append(lambda src, dst: ["ffmpeg", "-v", "error", "-y", "-i", src, "-frames:v", "1",
                                        "-vf", "scale=384:-2:flags=bilinear", dst])
    if shutil.which("magick"):
        makers.append(lambda src, dst: ["magick", src + "[0]", "-thumbnail", "384x", dst])
    if not makers:
        print("lumen-thumbs: no thumbnail maker found (gdk-pixbuf-thumbnailer, ffmpeg or magick)",
              file=sys.stderr, flush=True)

    def make(job):
        path, thumb = job
        tmp = thumb[:-4] + ".part.png"
        for maker in makers:
            try:
                r = subprocess.run(maker(path, tmp), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                   text=True, timeout=30)
                if r.returncode == 0 and os.path.exists(tmp) and os.path.getsize(tmp) > 0:
                    os.replace(tmp, thumb)
                    return job, True
                print("lumen-thumbs: %s: %s" % (path, (r.stderr or "failed").strip()[:200]),
                      file=sys.stderr, flush=True)
            except (OSError, subprocess.SubprocessError) as e:
                try:
                    print("lumen-thumbs: %s: %s" % (path, e), file=sys.stderr, flush=True)
                except OSError:
                    pass
            if os.path.exists(tmp):
                os.remove(tmp)
        return job, False

    # Closing the Wallpaper page stops this program; let it finish the
    # thumbnails anyway (quietly), so the next visit has them all.
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    quiet = False

    # Reported as each one finishes (not in order), so one slow picture
    # doesn't hold up the rest.
    with ThreadPoolExecutor(max_workers=max(2, min(6, os.cpu_count() or 2))) as pool:
        for fut in as_completed([pool.submit(make, job) for job in todo]):
            (path, thumb), ok = fut.result()
            if not quiet:
                try:
                    print("%s\t%s\t%s" % ("t" if ok else "x", path, thumb), flush=True)
                except (BrokenPipeError, OSError):
                    quiet = True


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass

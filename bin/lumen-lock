#!/usr/bin/env bash
# lumen-lock — lock the screen with the lumen lock screen.
#
# Usage:
#   lumen-lock          lock now (also run by xss-lock on idle and suspend)
#   lumen-lock --test   try the lock screen safely: Escape closes it
#
# The lock screen runs as its own Quickshell process, so a problem in the bar
# can't unlock the session. Each monitor gets a fullscreen window above all
# others. lumen-lock-grab takes the whole keyboard and mouse (an X grab), so
# no shortcut, click or other window can get past it; the bar and
# notifications are hidden. If the lock screen ever exits without a correct
# password, or can't take the keyboard, i3lock locks the screen instead.
set -uo pipefail

SHELL_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/lumen
RUNTIME=${XDG_RUNTIME_DIR:-/tmp}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/lumen
TEST=0
[[ ${1:-} == --test ]] && TEST=1

mkdir -p "$STATE"

# One lock at a time.
exec 9>"$RUNTIME/lumen-lock.lock"
flock -n 9 || exit 0

guard_pid=""
cleanup() {
	[[ -n $guard_pid ]] && kill "$guard_pid" 2>/dev/null
	qs -c lumen ipc call panels setLocked false >/dev/null 2>&1
	[[ -n ${old_ewmh:-} ]] && bspc config ignore_ewmh_focus "$old_ewmh" 2>/dev/null
	pkill -CONT -x sxhkd 2>/dev/null || true
	((TEST == 0)) && lumen-settings apply idle >/dev/null 2>&1   # the usual screen-off time again
}
trap cleanup EXIT

if ((TEST == 0)); then
	pkill -STOP -x sxhkd 2>/dev/null || true # no shortcuts behind the lock
fi
# While locked the screen goes off after a minute without input (unless
# Settings > Power says never). The idle clock starts again from now: it's
# usually long past a minute when idle locks the screen.
if ((TEST == 0)) && [[ $(lumen-settings get screen_off 2>/dev/null) != 0 ]] && command -v xset >/dev/null; then
	xset s reset 2>/dev/null
	xset +dpms dpms 0 0 60 2>/dev/null
fi

# Hide the bar, its popups and notifications while locked.
qs -c lumen ipc call panels setLocked true >/dev/null 2>&1

# Apps can't ask bspwm for focus while locked (restored afterwards).
old_ewmh=$(bspc config ignore_ewmh_focus 2>/dev/null)
bspc config ignore_ewmh_focus true 2>/dev/null
# One fullscreen lock window per monitor (the window title names its monitor).
for mon in $(bspc query -M --names); do
	bspc rule -a "*:*:lumen Lock $mon" -o monitor="$mon" state=fullscreen layer=above sticky=on border=off focus=on
done

LUMEN_LOCK_TEST=$TEST quickshell -p "$SHELL_DIR/lock.qml" >"$STATE/lock.log" 2>&1 &
qs_pid=$!

# Keep keyboard focus on a lock window.
(
	sleep 1
	while kill -0 "$qs_pid" 2>/dev/null; do
		locks=$(bspc query -N -n '.window.fullscreen.above.sticky' 2>/dev/null)
		focused=$(bspc query -N -n focused.window 2>/dev/null)
		if [[ -n $locks && ( -z $focused || " $(echo $locks) " != *" $focused "* ) ]]; then
			bspc node "${locks%%$'\n'*}" -f 2>/dev/null
		fi
		sleep 0.25
	done
) &
guard_pid=$!

wait "$qs_pid"
status=$?
# The input grab ends with the lock screen; make sure of it.
pkill -f "lumen-lock-grab" 2>/dev/null || true

# The lock screen exits with 0 only after a correct password (or Escape in
# test mode). Anything else means it stopped unexpectedly: lock with i3lock.
if ((status != 0 && TEST == 0)); then
	kill "$guard_pid" 2>/dev/null
	bg=$(sed -n 's/^bg=#//p' "${XDG_DATA_HOME:-$HOME/.local/share}/lumen/palettes/$(lumen-settings get accent 2>/dev/null || echo blue)-$(lumen-settings get mode 2>/dev/null || echo dark).conf" 2>/dev/null)
	i3lock -n -c "${bg:-070f1f}"
fi

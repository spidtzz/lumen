#!/usr/bin/env bash
# lumen-settings — read, change and apply lumen's settings.
#
# Usage:
#   lumen-settings get [key]            print one setting, or all of them
#   lumen-settings set <key> <value>    validate, save and apply a setting
#   lumen-settings apply [what]         session | theme | input | compositor | display | idle | wm
#   lumen-settings keys                 list settings with their allowed values
#   lumen-settings display-save <args>  remember xrandr arguments for next login
#   lumen-settings layout-next          switch to the next keyboard layout
#   lumen-settings layout-set <code>    switch to a layout in use (e.g. ir)
#   lumen-settings kbswitch             watch for the layout-switch keys (bspwmrc runs this)
#   lumen-settings sysinfo              system details for the About page
#   lumen-settings awake on|off|status  keep the screen on (Quick Settings)
#
# Settings live in ~/.config/lumen/settings.conf (key=value). Unknown keys and
# comments are kept, so it's safe to edit by hand.
set -euo pipefail

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
DIR=$CONFIG_HOME/lumen
SETTINGS=$DIR/settings.conf
DISPLAY_CONF=$DIR/display.conf
BIN_DIR=$(dirname "$(readlink -f "$0")")
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/lumen

die() { printf 'lumen-settings: %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- schema
# key ~ default ~ allowed (regex) ~ applier
SCHEMA=(
	"mode~dark~^(light|dark)$~theme"
	"accent~blue~^(blue|violet|teal|green|orange|pink|mono)$~theme"
	"bar_position~top~^(top|bottom|left|right)$~-"
	"bar_style~floating~^(floating|attached)$~-"
	"bar_black~false~^(true|false)$~-"
	"screen_corners~false~^(true|false)$~-"
	"volume_step~5~^([1-9]|1[0-9]|20)$~-"
	"font~Space Grotesk~^[A-Za-z0-9 ._-]{1,64}$~theme"
	"font_size~10~^([6-9]|1[0-9]|2[0-4])$~theme"
	"mono_font~JetBrains Mono~^[A-Za-z0-9 ._-]{1,64}$~theme"
	"clock_24h~true~^(true|false)$~-"
	"compositor~true~^(true|false)$~compositor"
	"focus_follows_mouse~true~^(true|false)$~wm"
	"window_buttons~false~^(true|false)$~theme"
	"corners~rounded~^(rounded|square)$~corners"
	"animations~true~^(true|false)$~compositor"
	"window_border~true~^(true|false)$~compositor"
	"clipboard_history~true~^(true|false)$~-"
	"notif_position~top-right~^(top|bottom)-(left|center|right)$~-"
	"bar_workspaces~5~^([3-9]|10)$~-"
	"tray_grouped~true~^(true|false)$~-"
	"qs_media~true~^(true|false)$~-"
	"idle_lock~10~^(0|5|10|15|30|60)$~idle"
	"kb_layouts~us~^[a-z]{2,3}(,[a-z]{2,3}){0,3}$~input"
	"kb_switch~alt_shift~^(alt_shift|ctrl_shift|caps)$~input"
	"repeat_delay~400~^([1-9][0-9]{2}|1000)$~input"
	"repeat_rate~30~^([1-5][0-9]|60)$~input"
	"pointer_speed~0~^-?(0(\.[0-9]{1,2})?|1(\.0{1,2})?)$~input"
	"natural_scroll~false~^(true|false)$~input"
	"tap_to_click~true~^(true|false)$~input"
	"wallpaper~~^(/.{1,500})?$~theme"
	"wallpaper_mode~fill~^(fill|fit|center|tile|stretch)$~theme"
	"wallpaper_subfolders~true~^(true|false)$~-"
)

schema_field() { # schema_field key index
	local row
	for row in "${SCHEMA[@]}"; do
		IFS='~' read -r -a f <<<"$row"
		[[ ${f[0]} == "$1" ]] && { printf '%s' "${f[$2]}"; return 0; }
	done
	return 1
}

# ---------------------------------------------------------------- storage
declare -A CONF
load() {
	local row k v
	for row in "${SCHEMA[@]}"; do
		IFS='~' read -r k v _ <<<"$row"
		CONF[$k]=$v
	done
	[[ -f $SETTINGS ]] || return 0
	while IFS='=' read -r k v || [[ -n $k ]]; do
		[[ $k =~ ^[a-z0-9_]+$ ]] || continue
		CONF[$k]=$v
	done <"$SETTINGS"
}

# Replace one key in place, keeping every other line (and the file's inode,
# so Quickshell's watcher keeps working).
store() {
	local key=$1 value=$2 line out=() found=0
	mkdir -p "$DIR"
	if [[ -f $SETTINGS ]]; then
		while IFS= read -r line || [[ -n $line ]]; do
			if [[ $line == "$key="* ]]; then
				out+=("$key=$value")
				found=1
			else
				out+=("$line")
			fi
		done <"$SETTINGS"
	else
		out+=("# lumen settings — edited by lumen-settings and the Settings app.")
	fi
	((found)) || out+=("$key=$value")
	printf '%s\n' "${out[@]}" >"$SETTINGS"
}

# ---------------------------------------------------------------- appliers
apply_theme() { "$BIN_DIR/lumen-theme" apply --quiet; }

apply_input() {
	[[ -n ${DISPLAY:-} ]] || return 0
	load
	# Layout switching is done by the `kbswitch` watcher below, not XKB's
	# grp:* options: those break when a layout (like Persian) uses Right Alt
	# for extra characters, and they hide which layout is active.
	if has setxkbmap; then
		set_layouts "${CONF[kb_layouts]}"
	fi
	has xset && xset r rate "${CONF[repeat_delay]}" "${CONF[repeat_rate]}"

	has xinput || return 0
	local id props nat tap
	[[ ${CONF[natural_scroll]} == true ]] && nat=1 || nat=0
	[[ ${CONF[tap_to_click]} == true ]] && tap=1 || tap=0
	for id in $(xinput list --id-only 2>/dev/null); do
		props=$(xinput list-props "$id" 2>/dev/null) || continue
		[[ $props == *"libinput Accel Speed ("* ]] &&
			xinput set-prop "$id" "libinput Accel Speed" "${CONF[pointer_speed]}" 2>/dev/null
		[[ $props == *"libinput Natural Scrolling Enabled ("* ]] &&
			xinput set-prop "$id" "libinput Natural Scrolling Enabled" "$nat" 2>/dev/null
		[[ $props == *"libinput Tapping Enabled ("* ]] &&
			xinput set-prop "$id" "libinput Tapping Enabled" "$tap" 2>/dev/null
	done
	return 0
}

# Load layouts (the first is active). XKB options are cleared, except that
# Caps Lock does nothing when it's the layout switch key.
set_layouts() {
	local args=(-layout "$1" -option "")
	[[ ${CONF[kb_switch]} == caps && $1 == *,* ]] && args+=(-option caps:none)
	setxkbmap "${args[@]}" && notify_keyboard
}

# Tell the bar which layout is active now.
notify_keyboard() {
	has qs && { qs -c lumen ipc call keyboard changed >/dev/null 2>&1 & } || true
}

current_layouts() {
	local cur
	cur=$(setxkbmap -query 2>/dev/null | sed -n 's/^layout:[[:space:]]*//p')
	printf '%s' "${cur:-${CONF[kb_layouts]}}"
}

# The active layout is always the first one: switching rotates the list.
layout_set() {
	[[ -n ${DISPLAY:-} ]] && has setxkbmap || return 0
	load
	local want=$1 cur list=() i n rotated=()
	cur=$(current_layouts)
	IFS=, read -r -a list <<<"$cur"
	n=${#list[@]}
	((n > 1)) || return 0
	for i in "${!list[@]}"; do
		[[ ${list[$i]} == "$want" ]] || continue
		rotated=("${list[@]:$i}" "${list[@]:0:$i}")
		local IFS=,
		set_layouts "${rotated[*]}"
		return 0
	done
	die "layout not in use: $want"
}

layout_next() {
	[[ -n ${DISPLAY:-} ]] && has setxkbmap || return 0
	load
	local cur
	cur=$(current_layouts)
	[[ $cur == *,* ]] || return 0
	cur=${cur#*,}
	layout_set "${cur%%,*}"
}

# Called by the watcher when a switch combination is released.
layout_hotkey() {
	load
	[[ $1 == "${CONF[kb_switch]}" ]] && layout_next
	return 0
}

# Watches raw input events. Mouse clicks close bar popups (see above).
# Keys: switches layout the way Windows does: when the
# combination (Alt+Shift, Ctrl+Shift or Caps Lock alone) is pressed and
# released without any other key. Works with left or right keys in every
# layout, and AltGr+Shift+key still types characters (the third key cancels).
# Keycodes are the standard evdev ones.
kbswitch() {
	has xinput || die "xinput is needed for layout switching"
	stdbuf -oL xinput test-xi2 --root | awk -v cmd="$0 layout-hotkey" \
		-v flag="${XDG_RUNTIME_DIR:-/tmp}/lumen-popup-open" \
		-v click="qs -c lumen ipc call panels click" '
		function isalt(k) { return k == 64 || k == 108 }
		function isshift(k) { return k == 50 || k == 62 }
		function isctrl(k) { return k == 37 || k == 105 }
		function count(c,   k, a, s, x) {
			a = s = x = c = 0
			for (k in down) { c++; if (isalt(k)) a++; else if (isshift(k)) s++; else if (isctrl(k)) x++ }
			nalt = a; nshift = s; nctrl = x
			return c
		}
		# Mouse clicks: tell the shell while a bar popup is open (the shell
		# creates the flag file), so a click elsewhere closes it.
		/RawButtonPress/ { t = 3; next }
		/^[[:space:]]+detail:/ && t == 3 {
			t = 0
			b = $2 + 0
			if (b >= 1 && b <= 3 && (getline line < flag) >= 0) { close(flag); system(click " >/dev/null 2>&1 &") }
			next
		}
		/RawKeyPress/ { t = 1; next }
		/RawKeyRelease/ { t = 2; next }
		/^[[:space:]]+detail:/ && t {
			k = $2 + 0
			if (t == 1) {
				if (!(k in down)) {
					down[k] = 1
					n = count()
					if (n == 2 && nshift == 1 && nalt == 1) combo = "alt_shift"
					else if (n == 2 && nshift == 1 && nctrl == 1) combo = "ctrl_shift"
					else if (n == 1 && k == 66) combo = "caps"
					else if (n == 1 && (isalt(k) || isshift(k) || isctrl(k))) combo = ""
					else combo = "-"   # another key: a shortcut or a character
				}
			} else {
				delete down[k]
				if (combo != "" && combo != "-") { system(cmd " " combo " &"); fflush() }
				if (combo != "") combo = (count() == 0) ? "" : "-"
			}
			t = 0
		}'
}

# picom's options that follow settings: square corners, no fades without
# animations. The file it was started with is remembered so a change in
# settings restarts it.
picom_flags() {
	local f=(--config "$STATE/picom.conf" --log-file "$STATE/picom.log")
	[[ ${CONF[corners]} == square ]] && f+=(--corner-radius 0)
	[[ ${CONF[animations]} == false ]] && f+=(--no-fading-openclose --fade-in-step 1 --fade-out-step 1)
	printf '%s\n' "${f[@]}"
}

# How the focused window is shown (Settings > Appearance > Windows):
#   outline  square corners: bspwm's accent border
#   glow     rounded corners: an accent shadow from picom, which follows the
#            rounded shape (bspwm's border is a square frame that picom can't
#            round, so it would stop short of each corner)
#   dim      highlight off: other windows are slightly dimmed
focus_style() {
	if [[ ${CONF[window_border]} == false ]]; then echo dim
	elif [[ ${CONF[compositor]} != true || ${CONF[corners]} == square ]]; then echo outline
	else echo glow
	fi
}

accent_colour() {
	local mode accent line
	mode=${CONF[mode]} accent=${CONF[accent]}
	line=$(grep -m1 '^accent=' "${XDG_DATA_HOME:-$HOME/.local/share}/lumen/palettes/$accent-$mode.conf" 2>/dev/null) || true
	printf '%s' "${line#accent=}"
}

# The picom config lumen runs: your ~/.config/picom/picom.conf plus rules.
picom_config() {
	local base=$CONFIG_HOME/picom/picom.conf colour q="'" rules=()
	colour=$(accent_colour)
	rules+=("{ match = \"window_type = ${q}dock${q} || window_type = ${q}desktop${q}\"; shadow = false; corner-radius = 0; }")
	rules+=("{ match = \"fullscreen\"; corner-radius = 0; }")
	# lumen's rounded screen corners: tiny pieces drawn above everything
	rules+=("{ match = \"override_redirect && width <= 32 && height <= 32\"; shadow = false; corner-radius = 0; fade = false; }")
	# GTK windows that draw their own shadow
	rules+=("{ match = \"_GTK_FRAME_EXTENTS@\"; shadow = false; }")
	case $(focus_style) in
		glow) [[ -n $colour ]] && rules+=("{ match = \"focused && window_type = ${q}normal${q} && !override_redirect && !_GTK_FRAME_EXTENTS@\"; shadow-color = \"$colour\"; }") ;;
		dim) rules+=("{ match = \"!focused && !override_redirect && (window_type = ${q}normal${q} || window_type = ${q}dialog${q})\"; dim = 0.08; }") ;;
	esac
	printf '# Generated by lumen-settings; edit %s instead.\n' "$base"
	[[ -f $base ]] && printf '@include "%s"\n' "$base"
	printf 'rules = (\n'
	local i
	for i in "${!rules[@]}"; do
		printf '  %s%s\n' "${rules[$i]}" "$( ((i < ${#rules[@]} - 1)) && printf ',')"
	done
	printf ');\n'
}

# bspwm's border is only used for the square-corner outline (see
# focus_style). Without the compositor it's always on, since nothing else
# would show the active window.
window_borders() {
	has bspc && bspc query -M >/dev/null 2>&1 || return 0
	if [[ ${CONF[compositor]} != true || $(focus_style) == outline ]]; then
		bspc config border_width 2
	else
		bspc config border_width 0
	fi
}

SUPERVISOR_PID=$STATE/picom-supervisor.pid

supervisor_running() {
	local pid
	pid=$(cat "$SUPERVISOR_PID" 2>/dev/null) || return 1
	[[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

apply_compositor() {
	[[ -n ${DISPLAY:-} ]] || return 0
	load
	window_borders
	if [[ ${CONF[compositor]} != true ]]; then
		supervisor_running && kill "$(cat "$SUPERVISOR_PID")" 2>/dev/null
		rm -f "$SUPERVISOR_PID" "$STATE/picom.flags"
		pkill -x picom 2>/dev/null || true
		return 0
	fi
	mkdir -p "$STATE"
	local flags conf changed=0
	mapfile -t flags < <(picom_flags)
	conf=$(picom_config)
	if [[ $conf != "$(cat "$STATE/picom.conf" 2>/dev/null)" ]]; then
		printf '%s\n' "$conf" >"$STATE/picom.conf"
		changed=1
	fi
	if supervisor_running; then
		if [[ $(printf '%s\n' "${flags[@]}") == "$(cat "$STATE/picom.flags" 2>/dev/null)" ]]; then
			# Same options: picom re-reads its config on SIGUSR1.
			if ((changed)); then pkill -USR1 -x picom || true; fi
		else
			# New options: the supervisor starts picom again with them.
			: >"$STATE/picom.restart"
			pkill -x picom 2>/dev/null || true
		fi
		return 0
	fi
	# A picom not started by the supervisor (older lumen, or by hand).
	pkill -x picom 2>/dev/null || true
	setsid -f "$BIN_DIR/lumen-settings" compositor-run >/dev/null 2>&1 </dev/null
}

# Runs picom and starts it again if it stops: picom's software renderer can
# crash after a few hours ("run out of XIDs"), which used to leave the
# desktop without shadows and rounded corners. If picom keeps failing right
# away, it steps down: GPU renderer -> software renderer -> without lumen's
# rules (the error is in ~/.local/state/lumen/picom.log).
compositor_run() {
	mkdir -p "$STATE"
	echo $$ >"$SUPERVISOR_PID"
	trap 'pkill -P $$ -x picom 2>/dev/null; rm -f "$SUPERVISOR_PID"; exit 0' TERM INT
	local level=0 fails=0 start status flags backend=() vm=0
	systemd-detect-virt -q 2>/dev/null && vm=1
	((vm)) && level=1   # virtual GPUs show black windows with the GPU renderer
	while :; do
		load
		[[ ${CONF[compositor]} == true ]] || break
		xset q >/dev/null 2>&1 || break   # the X session has ended
		mapfile -t flags < <(picom_flags)
		printf '%s\n' "${flags[@]}" >"$STATE/picom.flags"
		case $level in
			0) backend=() ;;
			1) backend=(--backend xrender) ;;
			*) backend=(--backend xrender); flags=(--log-file "$STATE/picom.log") ;;
		esac
		# Virtual GPUs miss partial redraws (windows flashing black), so
		# redraw the whole screen each frame there.
		((vm)) && backend+=(--no-use-damage)
		printf '[ %s lumen ] starting picom %s\n' "$(date '+%d/%m/%y %T')" "${backend[*]} ${flags[*]}" >>"$STATE/picom.log"
		start=$SECONDS
		status=0
		picom "${backend[@]}" "${flags[@]}" >>"$STATE/picom.log" 2>&1 || status=$?
		if [[ -e $STATE/picom.restart ]]; then   # stopped by apply_compositor to change options
			rm -f "$STATE/picom.restart"
			continue
		fi
		if ((SECONDS - start < 5)); then
			fails=$((fails + 1))
			if ((fails >= 2)); then
				((level >= 2)) && break
				level=$((level + 1))
				fails=0
			fi
		else
			fails=0
		fi
		printf '[ %s lumen ] picom stopped (exit %s), starting it again\n' "$(date '+%d/%m/%y %T')" "$status" >>"$STATE/picom.log"
		sleep 1
	done
	rm -f "$SUPERVISOR_PID"
}

apply_display() {
	[[ -n ${DISPLAY:-} && -s $DISPLAY_CONF ]] || return 0
	local args
	read -r -a args <"$DISPLAY_CONF"
	((${#args[@]})) && xrandr "${args[@]}" || true
}

# Lock after idle minutes (0 = never). xss-lock, started by bspwmrc, runs
# lumen-lock when the X screensaver timer fires and before suspend.
AWAKE_FLAG=${XDG_RUNTIME_DIR:-/tmp}/lumen-awake

apply_idle() {
	[[ -n ${DISPLAY:-} ]] && has xset || return 0
	load
	local secs=$((CONF[idle_lock] * 60))
	[[ -e $AWAKE_FLAG ]] && secs=0   # Keep awake is on
	if ((secs > 0)); then
		xset s "$secs" "$secs"
	else
		xset s off
	fi
	xset -dpms 2>/dev/null || true
}

# Window manager behaviour.
apply_wm() {
	has bspc && bspc query -M >/dev/null 2>&1 || return 0
	load
	bspc config focus_follows_pointer "${CONF[focus_follows_mouse]}"
}

apply_what() {
	case $1 in
		theme) apply_theme; apply_compositor ;;   # the focus glow uses the accent
		input) apply_input ;;
		compositor) apply_compositor ;;
		corners) apply_theme; apply_compositor ;;
		display) apply_display ;;
		idle) apply_idle ;;
		wm) apply_wm ;;
		session) apply_display; apply_input; apply_theme; apply_compositor; apply_idle; apply_wm ;;
		-) ;;
		*) die "unknown target: $1 (session, theme, input, compositor, display)" ;;
	esac
}

# ---------------------------------------------------------------- sysinfo
sysinfo() {
	local os kernel cpu mem gpu disk up qsv
	os=$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-Linux}")
	kernel=$(uname -r)
	cpu=$(sed -n 's/^model name[[:space:]]*: //p;T;q' /proc/cpuinfo)
	cpu="$cpu ($(nproc) threads)"
	mem=$(awk '/^MemTotal/ {printf "%.1f GiB", $2/1048576}' /proc/meminfo)
	if has lspci; then
		gpu=$(lspci 2>/dev/null | sed -n 's/.*\(VGA\|3D\|Display\)[^:]*: //p;T;q' || true)
	fi
	disk=$(df -h --output=used,size / 2>/dev/null | awk 'NR==2 {print $1 " of " $2 " used"}' || true)
	up=$(uptime -p 2>/dev/null || true)
	up=${up#up }
	qsv=$(quickshell --version 2>/dev/null || true)
	qsv=${qsv%%$'\n'*}
	printf 'hostname=%s\nos=%s\nkernel=%s\ncpu=%s\nmemory=%s\ngpu=%s\ndisk=%s\nuptime=%s\nquickshell=%s\nvirtual=%s\n' \
		"$(cat /etc/hostname 2>/dev/null || uname -n)" "$os" "$kernel" "$cpu" "$mem" "${gpu:-}" \
		"${disk:-}" "${up:-}" "${qsv:-}" "$(systemd-detect-virt 2>/dev/null || echo none)"
}

# ---------------------------------------------------------------- CLI
cmd=${1:-}
shift || true
case $cmd in
	get)
		load
		if [[ -n ${1:-} ]]; then
			[[ -v CONF[$1] ]] || die "unknown key: $1"
			printf '%s\n' "${CONF[$1]}"
		else
			for row in "${SCHEMA[@]}"; do
				k=${row%%~*}
				printf '%s=%s\n' "$k" "${CONF[$k]}"
			done
		fi
		;;
	set)
		[[ $# -eq 2 ]] || die "usage: lumen-settings set <key> <value>"
		pattern=$(schema_field "$1" 2) || die "unknown key: $1 (see: lumen-settings keys)"
		[[ $2 =~ $pattern ]] || die "invalid value for $1: '$2' (allowed: $pattern)"
		store "$1" "$2"
		apply_what "$(schema_field "$1" 3)"
		;;
	apply) apply_what "${1:-session}" ;;
	keys)
		for row in "${SCHEMA[@]}"; do
			IFS='~' read -r k d p _ <<<"$row"
			printf '%-15s default %-15s allowed %s\n' "$k" "$d" "$p"
		done
		;;
	display-save)
		(($#)) || die "usage: lumen-settings display-save <xrandr arguments...>"
		for a in "$@"; do
			[[ $a =~ ^[A-Za-z0-9._+x-]+$ ]] || die "unexpected xrandr argument: $a"
		done
		mkdir -p "$DIR"
		printf '%s\n' "$*" >"$DISPLAY_CONF"
		;;
	display-reset) rm -f "$DISPLAY_CONF" ;;
	layout-next) layout_next ;;
	layout-set) [[ -n ${1:-} ]] || die "usage: lumen-settings layout-set <layout>"; layout_set "$1" ;;
	layout-hotkey) layout_hotkey "${1:-}" ;;
	layout-current) load; cur=$(current_layouts); printf '%s\n' "${cur%%,*}" ;;
	kbswitch) kbswitch ;;
	compositor-run) compositor_run ;;
	sysinfo) sysinfo ;;
	awake)
		case ${1:-status} in
			on) : >"$AWAKE_FLAG"; apply_idle ;;
			off) rm -f "$AWAKE_FLAG"; apply_idle ;;
			status) [[ -e $AWAKE_FLAG ]] && echo on || echo off ;;
			*) die "usage: lumen-settings awake on|off|status" ;;
		esac
		;;
	-h | --help | help | "") sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command: $cmd (try --help)" ;;
esac

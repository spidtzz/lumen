#!/usr/bin/env bash
# lumen-theme — apply the lumen theme to Quickshell, GTK 3/4 (incl. libadwaita),
# Qt (via Qt's GTK3 theme + KDE apps), kitty, bspwm, the login screen and the
# X root window.
#
# Usage:
#   lumen-theme apply [--quiet]        regenerate and apply everything
#   lumen-theme set <key> <value>      same as lumen-settings set
#   lumen-theme toggle-mode            light <-> dark
#   lumen-theme cycle-accent           next accent colour
#   lumen-theme get [key]              print current settings
#   lumen-theme list                   print valid values
set -euo pipefail

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
SETTINGS=$CONFIG_HOME/lumen/settings.conf
PALETTES=$DATA_HOME/lumen/palettes
MARK="# Generated by lumen-theme. Changes are overwritten; edit ~/.config/lumen/settings.conf instead."

MODES=(light dark)
ACCENTS=(blue violet teal green orange pink mono)
POSITIONS=(top bottom left right)
KEYS=(mode accent bar_position font font_size mono_font wallpaper wallpaper_mode)

QUIET=0
say() { ((QUIET)) || printf 'lumen-theme: %s\n' "$*"; }
die() { printf 'lumen-theme: %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }
contains() { local x=$1; shift; local y; for y; do [[ $x == "$y" ]] && return 0; done; return 1; }

# ---------------------------------------------------------------- settings
load_settings() {
	mode=dark accent=blue bar_position=top
	font="Space Grotesk" font_size=10 mono_font="JetBrains Mono"
	wallpaper="" wallpaper_mode=fill
	if [[ -f $SETTINGS ]]; then
		local k v
		while IFS='=' read -r k v || [[ -n $k ]]; do
			k=${k//[[:space:]]/}
			contains "$k" "${KEYS[@]}" || continue
			printf -v "$k" '%s' "$v"
		done <"$SETTINGS"
	fi
	contains "$mode" "${MODES[@]}" || mode=dark
	contains "$accent" "${ACCENTS[@]}" || accent=blue
	contains "$bar_position" "${POSITIONS[@]}" || bar_position=top
	[[ $font_size =~ ^[0-9]+$ ]] || font_size=10
}

# ---------------------------------------------------------------- palette
declare -A P
load_palette() {
	local file=$PALETTES/$accent-$mode.conf k v
	[[ -f $file ]] || die "palette not found: $file (re-run install.sh)"
	while IFS='=' read -r k v; do
		[[ $k =~ ^[a-z_0-9]+$ ]] && P[$k]=$v
	done <"$file"
}

rgb() { local h=${1#\#}; printf '%d,%d,%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
argb() { printf '#ff%s' "${1#\#}"; }

# Overwrite a file we own. A file someone else wrote is backed up once first.
own() {
	local f=$1
	mkdir -p "${f%/*}"
	if [[ -f $f && ! -L $f ]] && ! grep -qF "lumen-theme" "$f" 2>/dev/null && [[ ! -e $f.pre-lumen ]]; then
		cp -p "$f" "$f.pre-lumen"
		say "backed up $f -> $f.pre-lumen"
	fi
	cat >"$f"
}

icon_theme() {
	local base=Adwaita
	if [[ -d /usr/share/icons/Papirus ]]; then
		base=Papirus
		[[ $mode == dark && -d /usr/share/icons/Papirus-Dark ]] && base=Papirus-Dark
	fi
	printf '%s' "$base"
}

gtk_theme() { [[ $mode == dark ]] && printf adw-gtk3-dark || printf adw-gtk3; }

# ---------------------------------------------------------------- GTK
# adw-gtk3 (GTK 3 and plain GTK 4) and libadwaita share these named colours,
# so one set of values makes GTK 3 and GTK 4 apps look the same.
gtk_named_colors() {
	cat <<-EOF
		@define-color accent_color ${P[accent]};
		@define-color accent_bg_color ${P[accent]};
		@define-color accent_fg_color ${P[on_accent]};
		@define-color destructive_color ${P[danger]};
		@define-color destructive_bg_color ${P[danger]};
		@define-color destructive_fg_color #ffffff;
		@define-color success_color ${P[success]};
		@define-color success_bg_color ${P[success]};
		@define-color success_fg_color #ffffff;
		@define-color warning_color ${P[warning]};
		@define-color warning_bg_color ${P[warning]};
		@define-color warning_fg_color rgba(0,0,0,0.8);
		@define-color error_color ${P[danger]};
		@define-color error_bg_color ${P[danger]};
		@define-color error_fg_color #ffffff;
		@define-color window_bg_color ${P[bg]};
		@define-color window_fg_color ${P[ink]};
		@define-color view_bg_color ${P[panel]};
		@define-color view_fg_color ${P[ink]};
		@define-color headerbar_bg_color ${P[bg]};
		@define-color headerbar_fg_color ${P[ink]};
		@define-color headerbar_border_color ${P[line]};
		@define-color headerbar_backdrop_color ${P[bg]};
		@define-color headerbar_shade_color rgba(0,0,0,0.12);
		@define-color sidebar_bg_color ${P[field]};
		@define-color sidebar_fg_color ${P[ink]};
		@define-color sidebar_backdrop_color ${P[field]};
		@define-color sidebar_shade_color rgba(0,0,0,0.08);
		@define-color secondary_sidebar_bg_color ${P[bg]};
		@define-color secondary_sidebar_fg_color ${P[ink]};
		@define-color card_bg_color ${P[panel]};
		@define-color card_fg_color ${P[ink]};
		@define-color card_shade_color rgba(0,0,0,0.08);
		@define-color dialog_bg_color ${P[panel]};
		@define-color dialog_fg_color ${P[ink]};
		@define-color popover_bg_color ${P[panel]};
		@define-color popover_fg_color ${P[ink]};
		@define-color thumbnail_bg_color ${P[panel]};
		@define-color thumbnail_fg_color ${P[ink]};
		@define-color shade_color rgba(0,0,0,0.12);
		@define-color scrollbar_outline_color ${P[line]};
		@define-color borders ${P[line]};
	EOF
}

write_gtk() {
	{ printf '/* %s */\n' "${MARK#\# }"; gtk_named_colors; } | own "$CONFIG_HOME/gtk-3.0/gtk.css"
	{
		printf '/* %s */\n' "${MARK#\# }"
		gtk_named_colors
		# libadwaita 1.6+ reads CSS variables; older releases use the names above.
		cat <<-EOF
			:root {
			  --accent-color: ${P[accent]};
			  --accent-bg-color: ${P[accent]};
			  --accent-fg-color: ${P[on_accent]};
			  --destructive-bg-color: ${P[danger]};
			  --success-bg-color: ${P[success]};
			  --warning-bg-color: ${P[warning]};
			  --error-bg-color: ${P[danger]};
			  --window-bg-color: ${P[bg]};
			  --window-fg-color: ${P[ink]};
			  --view-bg-color: ${P[panel]};
			  --view-fg-color: ${P[ink]};
			  --headerbar-bg-color: ${P[bg]};
			  --headerbar-fg-color: ${P[ink]};
			  --headerbar-backdrop-color: ${P[bg]};
			  --sidebar-bg-color: ${P[field]};
			  --sidebar-fg-color: ${P[ink]};
			  --sidebar-backdrop-color: ${P[field]};
			  --secondary-sidebar-bg-color: ${P[bg]};
			  --card-bg-color: ${P[panel]};
			  --card-fg-color: ${P[ink]};
			  --dialog-bg-color: ${P[panel]};
			  --dialog-fg-color: ${P[ink]};
			  --popover-bg-color: ${P[panel]};
			  --popover-fg-color: ${P[ink]};
			  --thumbnail-bg-color: ${P[panel]};
			  --border-color: ${P[line]};
			}
		EOF
	} | own "$CONFIG_HOME/gtk-4.0/gtk.css"

	local ver
	for ver in 3.0 4.0; do
		own "$CONFIG_HOME/gtk-$ver/settings.ini" <<-EOF
			$MARK
			[Settings]
			gtk-theme-name=$(gtk_theme)
			gtk-icon-theme-name=$(icon_theme)
			gtk-font-name=$font $font_size
			gtk-cursor-theme-name=Adwaita
			gtk-cursor-theme-size=24
		EOF
	done
}

write_xsettingsd() {
	local f=$CONFIG_HOME/xsettingsd/xsettingsd.conf theme=${1:-$(gtk_theme)}
	own "$f" <<-EOF
		$MARK
		Net/ThemeName "$theme"
		Net/IconThemeName "$(icon_theme)"
		Gtk/FontName "$font $font_size"
		Gtk/MonospaceFontName "$mono_font $font_size"
		Gtk/CursorThemeName "Adwaita"
		Gtk/CursorThemeSize 24
		Net/EnableEventSounds 0
		Xft/Antialias 1
		Xft/Hinting 1
		Xft/HintStyle "hintslight"
		Xft/RGBA "rgb"
	EOF
}

# Running GTK 3 apps re-read gtk.css only when the theme name changes, so
# briefly switch to plain Adwaita and back. Harmless when xsettingsd is off.
reload_gtk_live() {
	pgrep -x xsettingsd >/dev/null 2>&1 || return 0
	write_xsettingsd Adwaita
	pkill -HUP -x xsettingsd || true
	sleep 0.15
	write_xsettingsd
	pkill -HUP -x xsettingsd || true
}

# libadwaita (GTK 4) apps and browsers learn light/dark and the accent through
# the settings portal, which xdg-desktop-portal-gtk reads from gsettings.
write_gsettings() {
	has gsettings || return 0
	local schema=org.gnome.desktop.interface scheme=prefer-light gaccent
	[[ $mode == dark ]] && scheme=prefer-dark
	case $accent in violet) gaccent=purple ;; mono) gaccent=slate ;; *) gaccent=$accent ;; esac
	{
		gsettings set $schema color-scheme "$scheme"
		gsettings set $schema gtk-theme "$(gtk_theme)"
		gsettings set $schema icon-theme "$(icon_theme)"
		gsettings set $schema font-name "$font $font_size"
		gsettings set $schema monospace-font-name "$mono_font $font_size"
		gsettings set $schema cursor-theme Adwaita
		if gsettings range $schema accent-color >/dev/null 2>&1; then
			gsettings set $schema accent-color "$gaccent"
		fi
	} 2>/dev/null || true
}

# ---------------------------------------------------------------- Qt
# KDE apps (Dolphin, Kate, ...) colour parts of their UI from kdeglobals
# rather than the Qt palette, so mirror the palette there too.
write_kdeglobals() {
	local sec bgn bga fgn
	{
		echo "$MARK"
		echo "[General]"
		echo "ColorScheme=Lumen"
		echo "AccentColor=$(rgb "${P[accent]}")"
		echo
		echo "[Icons]"
		echo "Theme=$(icon_theme)"
		for sec in View Window Button Header Complementary Tooltip Selection; do
			case $sec in
				View) bgn=panel bga=field fgn=ink ;;
				Window | Header | Complementary) bgn=bg bga=field fgn=ink ;;
				Button) bgn=field bga=panel fgn=ink ;;
				Tooltip) bgn=ink bga=ink fgn=bg ;;
				Selection) bgn=accent bga=accent fgn=on_accent ;;
			esac
			echo
			echo "[Colors:$sec]"
			echo "BackgroundNormal=$(rgb "${P[$bgn]}")"
			echo "BackgroundAlternate=$(rgb "${P[$bga]}")"
			echo "ForegroundNormal=$(rgb "${P[$fgn]}")"
			if [[ $sec == Selection || $sec == Tooltip ]]; then
				echo "ForegroundInactive=$(rgb "${P[$fgn]}")"
				echo "ForegroundActive=$(rgb "${P[$fgn]}")"
			else
				echo "ForegroundInactive=$(rgb "${P[muted]}")"
				echo "ForegroundActive=$(rgb "${P[accent]}")"
			fi
			echo "ForegroundLink=$(rgb "${P[accent]}")"
			echo "ForegroundVisited=$(rgb "${P[accent]}")"
			echo "ForegroundNegative=$(rgb "${P[danger]}")"
			echo "ForegroundNeutral=$(rgb "${P[warning]}")"
			echo "ForegroundPositive=$(rgb "${P[success]}")"
			echo "DecorationFocus=$(rgb "${P[accent]}")"
			echo "DecorationHover=$(rgb "${P[accent]}")"
		done
	} | own "$CONFIG_HOME/kdeglobals"
}

# ---------------------------------------------------------------- others
write_kitty() {
	local i
	{
		echo "$MARK"
		echo "foreground ${P[ink]}"
		echo "background ${P[bg]}"
		echo "selection_foreground ${P[on_accent]}"
		echo "selection_background ${P[accent]}"
		echo "cursor ${P[accent]}"
		echo "cursor_text_color ${P[bg]}"
		echo "url_color ${P[accent]}"
		echo "active_border_color ${P[accent]}"
		echo "inactive_border_color ${P[line]}"
		echo "active_tab_foreground ${P[on_accent]}"
		echo "active_tab_background ${P[accent]}"
		echo "inactive_tab_foreground ${P[muted]}"
		echo "inactive_tab_background ${P[field]}"
		echo "tab_bar_background ${P[bg]}"
		for i in {0..15}; do echo "color$i ${P[color$i]}"; done
	} | own "$CONFIG_HOME/kitty/theme.conf"
	pkill -USR1 -x kitty 2>/dev/null || true # kitty reloads its config on SIGUSR1
}

# The login screen (values quoted: QSettings treats a bare # as a comment).
# The installer makes theme.conf.user owned by you, so
# this needs no root. SDDM reads it the next time the login screen starts.
SDDM_USER_CONF=/usr/share/sddm/themes/lumen/theme.conf.user
write_sddm() {
	[[ -w $SDDM_USER_CONF ]] || return 0
	cat >"$SDDM_USER_CONF" <<-EOF
		$MARK
		[General]
		mode="$mode"
		bg="${P[bg]}"
		panel="${P[panel]}"
		field="${P[field]}"
		ink="${P[ink]}"
		muted="${P[muted]}"
		line="${P[line]}"
		accent="${P[accent]}"
		on_accent="${P[on_accent]}"
		danger="${P[danger]}"
		font="$font"
	EOF
}

apply_bspwm() {
	has bspc && bspc query -M >/dev/null 2>&1 || return 0
	bspc config normal_border_color "${P[line]}"
	bspc config active_border_color "${P[line]}"
	bspc config focused_border_color "${P[accent]}"
	bspc config presel_feedback_color "${P[accent]}"
}

apply_root() {
	[[ -n ${DISPLAY:-} ]] || return 0
	# picom only draws a background that's published as a root pixmap, which
	# hsetroot does; plain xsetroot would leave the desktop black under picom.
	if has hsetroot; then
		# Wallpaper from Settings > Wallpaper, over the theme colour.
		local how=""
		case $wallpaper_mode in
			fill) how=-cover ;; fit) how=-full ;; center) how=-center ;;
			tile) how=-tile ;; stretch) how=-fill ;;
		esac
		if [[ -n $wallpaper && -r $wallpaper && -n $how ]]; then
			hsetroot -solid "${P[bg]}" "$how" "$wallpaper" >/dev/null 2>&1 ||
				hsetroot -solid "${P[bg]}" >/dev/null 2>&1 || true
		else
			hsetroot -solid "${P[bg]}" >/dev/null 2>&1 || true
		fi
	elif has xsetroot; then
		xsetroot -solid "${P[bg]}" 2>/dev/null || true
	fi
}

apply() {
	load_settings
	load_palette
	write_gtk
	write_xsettingsd
	write_gsettings
	write_kdeglobals
	write_kitty
	write_sddm
	apply_bspwm
	apply_root
	reload_gtk_live
	say "applied $accent / $mode"
}

# ---------------------------------------------------------------- CLI
# Settings are stored by lumen-settings; these commands are shortcuts to it.
SETTINGS_BIN=$(dirname "$(readlink -f "$0")")/lumen-settings
[[ -x $SETTINGS_BIN ]] || SETTINGS_BIN=lumen-settings

cmd=${1:-apply}
shift || true
case $cmd in
	apply)
		[[ ${1:-} == --quiet ]] && QUIET=1
		apply
		;;
	set) exec "$SETTINGS_BIN" set "$@" ;;
	get) exec "$SETTINGS_BIN" get "$@" ;;
	toggle-mode)
		load_settings
		[[ $mode == dark ]] && next=light || next=dark
		exec "$SETTINGS_BIN" set mode "$next"
		;;
	cycle-accent)
		load_settings
		next=blue
		for i in "${!ACCENTS[@]}"; do
			[[ ${ACCENTS[$i]} == "$accent" ]] && { next=${ACCENTS[$(((i + 1) % ${#ACCENTS[@]}))]}; break; }
		done
		exec "$SETTINGS_BIN" set accent "$next"
		;;
	list)
		echo "mode: ${MODES[*]}"
		echo "accent: ${ACCENTS[*]}"
		echo "bar_position: ${POSITIONS[*]}"
		;;
	-h | --help | help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command: $cmd (try --help)" ;;
esac

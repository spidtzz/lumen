#!/bin/sh
# lumen — X session started with `startx` (when not using SDDM).

# Distro-provided session setup (D-Bus/systemd environment import).
# SDDM does this itself, so it lives here rather than in lumen-session.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
	for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
		[ -x "$f" ] && . "$f"
	done
	unset f
fi

exec "$HOME/.local/bin/lumen-session"

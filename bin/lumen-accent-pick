#!/usr/bin/env python3
"""lumen-accent-pick: the lumen accent closest to a picture's main colour.

    lumen-accent-pick <picture>    prints an accent name (blue, teal, ..., mono)

The picture is shrunk to 48x48 by ffmpeg (installed with mpv), then each
pixel is turned into OKLCH. Colourful pixels vote for their hue, weighted by
how colourful they are; the hue with the most votes picks the nearest accent.
A picture with hardly any colour (greyscale, very dark) gets mono.
"""
import math
import subprocess
import sys

# Accent hues (OKLCH), as in tools/gen-palettes.py and Pane.
HUES = {"blue": 262, "violet": 295, "teal": 190, "green": 150, "orange": 55, "pink": 355,
        "red": 25, "amber": 85, "lime": 125, "cyan": 215, "sky": 240, "indigo": 278, "fuchsia": 325}
SIZE = 48


def lin(c):
    c /= 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def oklch(r, g, b):
    r, g, b = lin(r), lin(g), lin(b)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def main():
    if len(sys.argv) != 2:
        print("usage: lumen-accent-pick <picture>", file=sys.stderr)
        return 2
    try:
        raw = subprocess.run(
            ["ffmpeg", "-v", "error", "-i", sys.argv[1], "-frames:v", "1",
             "-vf", f"scale={SIZE}:{SIZE}:flags=area", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
            capture_output=True, timeout=20, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        print("lumen-accent-pick: can't read the picture (is ffmpeg installed?)", file=sys.stderr)
        return 1
    if len(raw) < 3:
        return 1

    bins = [0.0] * 72          # 5° each
    colourful = 0.0
    n = len(raw) // 3
    for i in range(n):
        L, C, h = oklch(raw[3 * i], raw[3 * i + 1], raw[3 * i + 2])
        if C < 0.03 or L < 0.15 or L > 0.97:
            continue           # greys, near-black and near-white don't vote
        w = C * (1 - abs(L - 0.62))   # vivid mid-tones count most
        bins[int(h // 5) % 72] += w
        colourful += w

    if colourful < 0.006 * n:
        print("mono")
        return 0
    # The strongest 15° window, then its weighted mean hue.
    best = max(range(72), key=lambda i: bins[i - 1] + bins[i] + bins[(i + 1) % 72])
    x = y = 0.0
    for j in (best - 1, best, (best + 1) % 72):
        ang = math.radians(j * 5 + 2.5)
        x += bins[j] * math.cos(ang)
        y += bins[j] * math.sin(ang)
    hue = math.degrees(math.atan2(y, x)) % 360

    def dist(a):
        d = abs(HUES[a] - hue) % 360
        return min(d, 360 - d)
    print(min(HUES, key=dist))
    return 0


if __name__ == "__main__":
    sys.exit(main())

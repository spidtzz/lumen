#!/usr/bin/env bash
# lumen-theme — apply the lumen theme to Quickshell, GTK 3/4 (incl. libadwaita),
# Qt (via Qt's GTK3 theme + KDE apps), kitty, bspwm, the login screen and the
# X root window.
#
# Usage:
#   lumen-theme apply [--quiet]        regenerate and apply everything
#   lumen-theme set <key> <value>      same as lumen-settings set
#   lumen-theme toggle-mode            light <-> dark (black counts as dark)
#   lumen-theme cycle-accent           next accent colour
#   lumen-theme get [key]              print current settings
#   lumen-theme list                   print valid values
set -euo pipefail

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
SETTINGS=$CONFIG_HOME/lumen/settings.conf
PALETTES=$DATA_HOME/lumen/palettes
MARK="# Generated by lumen-theme. Changes are overwritten; edit ~/.config/lumen/settings.conf instead."

MODES=(light dark black)   # black: dark on pure black (OLED), as in Pane
ACCENTS=(blue violet teal green orange pink red amber lime cyan sky indigo fuchsia mono)
POSITIONS=(top bottom left right)
KEYS=(mode accent bar_position font font_size mono_font wallpaper wallpaper_mode window_buttons corners
	theme_btop theme_discord theme_zathura theme_browser)

QUIET=0
say() { ((QUIET)) || printf 'lumen-theme: %s\n' "$*"; }
die() { printf 'lumen-theme: %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }
contains() { local x=$1; shift; local y; for y; do [[ $x == "$y" ]] && return 0; done; return 1; }

# ---------------------------------------------------------------- settings
load_settings() {
	mode=dark accent=blue bar_position=top
	font="Space Grotesk" font_size=10 mono_font="JetBrains Mono"
	wallpaper="" wallpaper_mode=fill window_buttons=false corners=rounded
	if [[ -f $SETTINGS ]]; then
		local k v
		while IFS='=' read -r k v || [[ -n $k ]]; do
			k=${k//[[:space:]]/}
			contains "$k" "${KEYS[@]}" || continue
			printf -v "$k" '%s' "$v"
		done <"$SETTINGS"
	fi
	contains "$mode" "${MODES[@]}" || mode=dark
	contains "$accent" "${ACCENTS[@]}" || accent=blue
	contains "$bar_position" "${POSITIONS[@]}" || bar_position=top
	[[ $font_size =~ ^[0-9]+$ ]] || font_size=10
}

# ------------------------------------------------- other apps (experimental)
# Settings > Appearance > Other apps. Each writes a lumen theme file into the
# app's own theme folder and points the app at it; turning it off removes
# both again. Nothing is written for apps that aren't installed/configured.

hexa() { printf 'rgba(%s, %s)' "$(rgb "$1")" "$2"; }

write_btop() {
	local dir=$CONFIG_HOME/btop theme=$CONFIG_HOME/btop/themes/lumen.theme conf=$CONFIG_HOME/btop/btop.conf
	if [[ ${theme_btop:-false} != true ]]; then
		[[ -f $conf ]] && grep -q 'lumen.theme' "$conf" && sed -i 's|^color_theme = .*|color_theme = "Default"|' "$conf"
		rm -f "$theme"
		return 0
	fi
	has btop || [[ -d $dir ]] || return 0
	mkdir -p "$dir/themes"
	{
		printf '# %s\n' "${MARK#\# }"
		printf 'theme[main_bg]="%s"\ntheme[main_fg]="%s"\ntheme[title]="%s"\n' "${P[bg]}" "${P[ink]}" "${P[ink]}"
		printf 'theme[hi_fg]="%s"\ntheme[selected_bg]="%s"\ntheme[selected_fg]="%s"\n' "${P[accent]}" "${P[line]}" "${P[ink]}"
		printf 'theme[inactive_fg]="%s"\ntheme[graph_text]="%s"\ntheme[meter_bg]="%s"\n' "${P[muted]}" "${P[muted]}" "${P[line]}"
		printf 'theme[proc_misc]="%s"\ntheme[div_line]="%s"\n' "${P[accent]}" "${P[line]}"
		local box
		for box in cpu_box mem_box net_box proc_box; do printf 'theme[%s]="%s"\n' "$box" "${P[line]}"; done
		local g
		for g in temp cpu used process; do
			printf 'theme[%s_start]="%s"\ntheme[%s_mid]="%s"\ntheme[%s_end]="%s"\n' \
				"$g" "${P[accent]}" "$g" "${P[warning]}" "$g" "${P[danger]}"
		done
		for g in free cached available download; do
			printf 'theme[%s_start]="%s"\ntheme[%s_mid]="%s"\ntheme[%s_end]="%s"\n' \
				"$g" "${P[muted]}" "$g" "${P[accent]}" "$g" "${P[success]}"
		done
		printf 'theme[upload_start]="%s"\ntheme[upload_mid]="%s"\ntheme[upload_end]="%s"\n' "${P[muted]}" "${P[color5]}" "${P[color13]}"
	} | own "$theme"
	if [[ -f $conf ]]; then
		grep -q "^color_theme = \"$theme\"" "$conf" ||
			{ grep -q '^color_theme' "$conf" && sed -i "s|^color_theme = .*|color_theme = \"$theme\"|" "$conf" ||
				printf 'color_theme = "%s"\n' "$theme" >>"$conf"; }
	else
		printf 'color_theme = "%s"\n' "$theme" >"$conf"
	fi
}

# Discord through Vesktop, Vencord, Equicord or Equibop (client mods with
# theme support). The theme reloads live in a running Discord.
discord_dirs() {
	local d
	for d in vesktop Vencord Equicord equibop; do
		[[ -d $CONFIG_HOME/$d ]] && printf '%s\n' "$CONFIG_HOME/$d"
	done
}

discord_enable() { # <settings.json> <add|remove>
	[[ -f $1 ]] && has python3 || return 0
	python3 - "$1" "$2" <<'PY'
import json, sys
path, mode = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
except (OSError, ValueError):
    sys.exit(0)
themes = data.get("enabledThemes") or []
changed = False
if mode == "add" and "lumen.css" not in themes:
    themes.append("lumen.css"); changed = True
elif mode == "remove" and "lumen.css" in themes:
    themes.remove("lumen.css"); changed = True
if changed:
    data["enabledThemes"] = themes
    with open(path, "w") as f:
        json.dump(data, f, indent=4)
PY
}

write_discord() {
	local dir
	while IFS= read -r dir; do
		[[ -n $dir ]] || continue
		if [[ ${theme_discord:-false} != true ]]; then
			rm -f "$dir/themes/lumen.css"
			discord_enable "$dir/settings/settings.json" remove
			continue
		fi
		mkdir -p "$dir/themes"
		cat <<-EOF | own "$dir/themes/lumen.css"
			/**
			 * @name lumen
			 * @description Colours from the lumen desktop (${accent} / ${mode}). ${MARK#\# }
			 */
			:root, .theme-dark, .theme-light, .theme-darker, .theme-midnight, .visual-refresh {
			  --background-primary: ${P[panel]};
			  --background-secondary: ${P[bg]};
			  --background-secondary-alt: ${P[field]};
			  --background-tertiary: ${P[deep]};
			  --background-floating: ${P[panel]};
			  --background-nested-floating: ${P[panel]};
			  --background-mobile-primary: ${P[panel]};
			  --background-mobile-secondary: ${P[bg]};
			  --background-base-lowest: ${P[deep]};
			  --background-base-lower: ${P[bg]};
			  --background-base-low: ${P[bg]};
			  --background-surface-high: ${P[panel]};
			  --background-surface-higher: ${P[field]};
			  --background-surface-highest: ${P[field]};
			  --chat-background-default: ${P[panel]};
			  --channeltextarea-background: ${P[field]};
			  --input-background: ${P[field]};
			  --modal-background: ${P[panel]};
			  --background-modifier-hover: $(hexa "${P[accent]}" 0.08);
			  --background-modifier-active: $(hexa "${P[accent]}" 0.14);
			  --background-modifier-selected: $(hexa "${P[accent]}" 0.18);
			  --background-modifier-accent: ${P[line]};
			  --border-subtle: ${P[line]};
			  --border-faint: ${P[line]};
			  --text-normal: ${P[ink]};
			  --text-default: ${P[ink]};
			  --text-strong: ${P[ink]};
			  --text-muted: ${P[muted]};
			  --text-link: ${P[accent]};
			  --header-primary: ${P[ink]};
			  --header-secondary: ${P[muted]};
			  --channels-default: ${P[muted]};
			  --interactive-normal: ${P[muted]};
			  --interactive-hover: ${P[ink]};
			  --interactive-active: ${P[ink]};
			  --interactive-muted: ${P[line]};
			  --brand-experiment: ${P[accent]};
			  --brand-500: ${P[accent]};
			  --brand-560: ${P[accent]};
			  --control-brand-foreground: ${P[accent]};
			  --control-brand-foreground-new: ${P[accent]};
			  --button-filled-brand-background: ${P[accent]};
			  --button-filled-brand-text: ${P[on_accent]};
			  --mention-background: $(hexa "${P[accent]}" 0.12);
			  --mention-foreground: ${P[accent]};
			  --status-danger: ${P[danger]};
			  --status-positive: ${P[success]};
			  --status-warning: ${P[warning]};
			}
		EOF
		discord_enable "$dir/settings/settings.json" add
	done < <(discord_dirs)
}

write_zathura() {
	local dir=$CONFIG_HOME/zathura rc=$CONFIG_HOME/zathura/zathurarc colors=$CONFIG_HOME/zathura/lumen-colors
	if [[ ${theme_zathura:-false} != true ]]; then
		[[ -f $rc ]] && sed -i '/^include lumen-colors$/d' "$rc"
		rm -f "$colors"
		return 0
	fi
	has zathura || [[ -d $dir ]] || return 0
	cat <<-EOF | own "$colors"
		# ${MARK#\# }
		set default-bg "${P[bg]}"
		set default-fg "${P[ink]}"
		set statusbar-bg "${P[panel]}"
		set statusbar-fg "${P[ink]}"
		set inputbar-bg "${P[field]}"
		set inputbar-fg "${P[ink]}"
		set notification-bg "${P[panel]}"
		set notification-fg "${P[ink]}"
		set notification-error-bg "${P[danger]}"
		set notification-error-fg "${P[on_accent]}"
		set notification-warning-bg "${P[warning]}"
		set notification-warning-fg "${P[on_accent]}"
		set highlight-color "$(hexa "${P[accent]}" 0.35)"
		set highlight-active-color "$(hexa "${P[accent]}" 0.6)"
		set completion-bg "${P[panel]}"
		set completion-fg "${P[ink]}"
		set completion-highlight-bg "${P[accent]}"
		set completion-highlight-fg "${P[on_accent]}"
		set index-bg "${P[bg]}"
		set index-fg "${P[ink]}"
		set index-active-bg "${P[accent]}"
		set index-active-fg "${P[on_accent]}"
		set recolor-lightcolor "${P[bg]}"
		set recolor-darkcolor "${P[ink]}"
	EOF
	[[ -f $rc ]] && grep -qx 'include lumen-colors' "$rc" || printf 'include lumen-colors\n' >>"$rc"
}

# Firefox and LibreWolf: a marked block in each profile's chrome/userChrome.css
# (browser frame) and chrome/userContent.css (new tab page), plus the pref
# that lets the browser read them. Takes effect when the browser restarts.
browser_profiles() {
	local base p
	for base in "$HOME/.mozilla/firefox" "$CONFIG_HOME/mozilla/firefox" \
		"$HOME/.librewolf" "$CONFIG_HOME/librewolf/librewolf"; do
		for p in "$base"/*/prefs.js; do
			[[ -f $p ]] && printf '%s\n' "${p%/prefs.js}"
		done
	done
}

# Replace (or remove, with no content) the lumen block in a file.
lumen_block() { # <file> <comment-start> <comment-end> [content]
	local f=$1 a=$2 z=$3 body=${4-}
	local begin="$a lumen start (generated by lumen-theme) $z" end="$a lumen end $z"
	if [[ -f $f ]]; then
		awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$f" >"$f.lumen-tmp" &&
			mv "$f.lumen-tmp" "$f"
	fi
	[[ -n $body ]] || return 0
	mkdir -p "${f%/*}"
	printf '%s\n%s\n%s\n' "$begin" "$body" "$end" >>"$f"
}

write_browsers() {
	local prof on=${theme_browser:-false} chrome content pref
	pref='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
	# Firefox sets many of these on the toolbars and the sidebar themselves,
	# so they're set there too, and the main surfaces get their colours
	# directly as well.
	chrome=":root, #navigator-toolbox, #TabsToolbar, #nav-bar, #PersonalToolbar, #titlebar,
#sidebar-box, #sidebar-main, sidebar-main, #vertical-tabs, #sidebar-header, #sidebar, #browser {
  --toolbox-bgcolor: ${P[bg]} !important;
  --toolbox-bgcolor-inactive: ${P[bg]} !important;
  --toolbox-textcolor: ${P[ink]} !important;
  --toolbox-textcolor-inactive: ${P[muted]} !important;
  --lwt-accent-color: ${P[bg]} !important;
  --lwt-accent-color-inactive: ${P[bg]} !important;
  --lwt-text-color: ${P[ink]} !important;
  --toolbar-bgcolor: ${P[panel]} !important;
  --toolbar-color: ${P[ink]} !important;
  --toolbar-field-background-color: ${P[field]} !important;
  --toolbar-field-color: ${P[ink]} !important;
  --toolbar-field-border-color: ${P[line]} !important;
  --toolbar-field-focus-background-color: ${P[field]} !important;
  --toolbar-field-focus-color: ${P[ink]} !important;
  --toolbar-field-focus-border-color: ${P[accent]} !important;
  --toolbarbutton-icon-fill: ${P[ink]} !important;
  --toolbarbutton-hover-background: $(hexa "${P[ink]}" 0.08) !important;
  --toolbarbutton-active-background: $(hexa "${P[ink]}" 0.14) !important;
  --tab-selected-bgcolor: ${P[panel]} !important;
  --tab-selected-textcolor: ${P[ink]} !important;
  --tab-hover-background-color: $(hexa "${P[ink]}" 0.06) !important;
  --lwt-selected-tab-background-color: ${P[panel]} !important;
  --lwt-tab-text: ${P[ink]} !important;
  --tab-loading-fill: ${P[accent]} !important;
  --focus-outline-color: ${P[accent]} !important;
  --chrome-content-separator-color: ${P[line]} !important;
  --arrowpanel-background: ${P[panel]} !important;
  --arrowpanel-color: ${P[ink]} !important;
  --arrowpanel-border-color: ${P[line]} !important;
  --panel-separator-color: ${P[line]} !important;
  --sidebar-background-color: ${P[bg]} !important;
  --sidebar-text-color: ${P[ink]} !important;
  --sidebar-border-color: ${P[line]} !important;
  --urlbarView-highlight-background: ${P[accent]} !important;
  --urlbarView-highlight-color: ${P[on_accent]} !important;
  --button-primary-bgcolor: ${P[accent]} !important;
  --button-primary-color: ${P[on_accent]} !important;
  --color-accent-primary: ${P[accent]} !important;
}
#navigator-toolbox, #TabsToolbar, #titlebar { background-color: ${P[bg]} !important; color: ${P[ink]} !important; }
#nav-bar, #PersonalToolbar, #FindToolbar { background-color: ${P[panel]} !important; color: ${P[ink]} !important; }
.tab-background:is([selected], [multiselected]) { background: ${P[panel]} !important; }
.tabbrowser-tab { color: ${P[ink]} !important; }
#sidebar-box, #sidebar-main, sidebar-main, #vertical-tabs, #sidebar-header, #sidebar, #sidebar-splitter,
#bookmarksPanel, #history-panel, .sidebar-panel, #sidebar-search-container {
  background-color: ${P[bg]} !important; color: ${P[ink]} !important; border-color: ${P[line]} !important;
}"
	content="@-moz-document url(\"about:newtab\"), url(\"about:home\"), url(\"about:blank\"), url(\"about:privatebrowsing\") {
  :root, body {
    --newtab-background-color: ${P[bg]} !important;
    --newtab-background-color-secondary: ${P[panel]} !important;
    --newtab-text-primary-color: ${P[ink]} !important;
    --newtab-primary-action-background: ${P[accent]} !important;
    --in-content-page-background: ${P[bg]} !important;
    background-color: ${P[bg]} !important;
    color: ${P[ink]} !important;
  }
}"
	while IFS= read -r prof; do
		[[ -n $prof ]] || continue
		if [[ $on == true ]]; then
			lumen_block "$prof/chrome/userChrome.css" "/*" "*/" "$chrome"
			lumen_block "$prof/chrome/userContent.css" "/*" "*/" "$content"
			lumen_block "$prof/user.js" "//" "" "$pref"
		else
			lumen_block "$prof/chrome/userChrome.css" "/*" "*/"
			lumen_block "$prof/chrome/userContent.css" "/*" "*/"
			lumen_block "$prof/user.js" "//" ""
		fi
	done < <(browser_profiles)
}

write_other_apps() {
	write_btop
	write_discord
	write_zathura
	write_browsers
}

# ---------------------------------------------------------------- palette
declare -A P
load_palette() {
	local file=$PALETTES/$accent-$mode.conf k v repo
	# A palette added to lumen after install (with --link the repo is next
	# to this script): copy it over instead of failing.
	if [[ ! -f $file ]]; then
		repo=$(dirname "$(readlink -f "$0")")/../share/palettes
		[[ -f $repo/$accent-$mode.conf ]] && mkdir -p "$PALETTES" && cp -n "$repo"/*.conf "$PALETTES"/ 2>/dev/null
	fi
	[[ -f $file ]] || die "palette not found: $file (re-run install.sh)"
	while IFS='=' read -r k v; do
		[[ $k =~ ^[a-z_0-9]+$ ]] && P[$k]=$v
	done <"$file"
}

rgb() { local h=${1#\#}; printf '%d,%d,%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
argb() { printf '#ff%s' "${1#\#}"; }

# Overwrite a file we own. A file someone else wrote is backed up once first.
own() {
	local f=$1
	mkdir -p "${f%/*}"
	if [[ -f $f && ! -L $f ]] && ! grep -qF "lumen-theme" "$f" 2>/dev/null && [[ ! -e $f.pre-lumen ]]; then
		cp -p "$f" "$f.pre-lumen"
		say "backed up $f -> $f.pre-lumen"
	fi
	cat >"$f"
}

icon_theme() {
	local base=Adwaita
	if [[ -d /usr/share/icons/Papirus ]]; then
		base=Papirus
		[[ $mode != light && -d /usr/share/icons/Papirus-Dark ]] && base=Papirus-Dark
	fi
	printf '%s' "$base"
}

gtk_theme() { [[ $mode != light ]] && printf adw-gtk3-dark || printf adw-gtk3; }

# Title-bar buttons in apps that draw their own (GTK, libadwaita, Firefox,
# Telegram...). Off by default: windows are closed with super + q.
decoration_layout() { [[ $window_buttons == true ]] && printf 'menu:minimize,maximize,close' || printf 'menu:'; }

# ---------------------------------------------------------------- GTK
# adw-gtk3 (GTK 3 and plain GTK 4) and libadwaita share these named colours,
# so one set of values makes GTK 3 and GTK 4 apps look the same.
gtk_named_colors() {
	cat <<-EOF
		@define-color accent_color ${P[accent]};
		@define-color accent_bg_color ${P[accent]};
		@define-color accent_fg_color ${P[on_accent]};
		@define-color destructive_color ${P[danger]};
		@define-color destructive_bg_color ${P[danger]};
		@define-color destructive_fg_color #ffffff;
		@define-color success_color ${P[success]};
		@define-color success_bg_color ${P[success]};
		@define-color success_fg_color #ffffff;
		@define-color warning_color ${P[warning]};
		@define-color warning_bg_color ${P[warning]};
		@define-color warning_fg_color rgba(0,0,0,0.8);
		@define-color error_color ${P[danger]};
		@define-color error_bg_color ${P[danger]};
		@define-color error_fg_color #ffffff;
		@define-color window_bg_color ${P[bg]};
		@define-color window_fg_color ${P[ink]};
		@define-color view_bg_color ${P[panel]};
		@define-color view_fg_color ${P[ink]};
		@define-color headerbar_bg_color ${P[bg]};
		@define-color headerbar_fg_color ${P[ink]};
		@define-color headerbar_border_color ${P[line]};
		@define-color headerbar_backdrop_color ${P[bg]};
		@define-color headerbar_shade_color rgba(0,0,0,0.12);
		@define-color sidebar_bg_color ${P[field]};
		@define-color sidebar_fg_color ${P[ink]};
		@define-color sidebar_backdrop_color ${P[field]};
		@define-color sidebar_shade_color rgba(0,0,0,0.08);
		@define-color secondary_sidebar_bg_color ${P[bg]};
		@define-color secondary_sidebar_fg_color ${P[ink]};
		@define-color card_bg_color ${P[panel]};
		@define-color card_fg_color ${P[ink]};
		@define-color card_shade_color rgba(0,0,0,0.08);
		@define-color dialog_bg_color ${P[panel]};
		@define-color dialog_fg_color ${P[ink]};
		@define-color popover_bg_color ${P[panel]};
		@define-color popover_fg_color ${P[ink]};
		@define-color thumbnail_bg_color ${P[panel]};
		@define-color thumbnail_fg_color ${P[ink]};
		@define-color shade_color rgba(0,0,0,0.12);
		@define-color scrollbar_outline_color ${P[line]};
		@define-color borders ${P[line]};
	EOF
}

# Square corners (Settings > Appearance): user CSS outranks the theme, so
# this flattens every rounded element, windows included. Radio buttons stay
# round so they still look different from checkboxes.
gtk_corners() {
	[[ $corners == square ]] || return 0
	printf '\n/* square corners */\n'
	printf '* { border-radius: 0; %s}\n' "$1"
	printf 'radio, radio > check { border-radius: 9999px; }\n'
}

# bspwm draws no window frames, and picom draws the shadows (and the focus
# glow). Windows that draw their own title bar (Nautilus, Firefox...) would
# otherwise add their own shadow in a margin around the window: a dark band
# inside the tile and a second, offset shadow. Menus keep theirs.
gtk_no_csd_shadow() {
	printf '\n/* no client-side window shadows under bspwm */\n'
	printf '%s { box-shadow: none; margin: 0; }\n' "$1"
}

write_gtk() {
	{
		printf '/* %s */\n' "${MARK#\# }"
		gtk_named_colors
		gtk_no_csd_shadow 'window.csd:not(.popup) > decoration, window.csd:not(.popup) > decoration:backdrop'
		gtk_corners '-gtk-outline-radius: 0; '
	} | own "$CONFIG_HOME/gtk-3.0/gtk.css"
	{
		printf '/* %s */\n' "${MARK#\# }"
		gtk_named_colors
		gtk_no_csd_shadow 'window.csd:not(.popup), window.csd:not(.popup):backdrop'
		gtk_corners ''
		# libadwaita 1.6+ reads CSS variables; older releases use the names above.
		cat <<-EOF
			:root {
			  --accent-color: ${P[accent]};
			  --accent-bg-color: ${P[accent]};
			  --accent-fg-color: ${P[on_accent]};
			  --destructive-bg-color: ${P[danger]};
			  --success-bg-color: ${P[success]};
			  --warning-bg-color: ${P[warning]};
			  --error-bg-color: ${P[danger]};
			  --window-bg-color: ${P[bg]};
			  --window-fg-color: ${P[ink]};
			  --view-bg-color: ${P[panel]};
			  --view-fg-color: ${P[ink]};
			  --headerbar-bg-color: ${P[bg]};
			  --headerbar-fg-color: ${P[ink]};
			  --headerbar-backdrop-color: ${P[bg]};
			  --sidebar-bg-color: ${P[field]};
			  --sidebar-fg-color: ${P[ink]};
			  --sidebar-backdrop-color: ${P[field]};
			  --secondary-sidebar-bg-color: ${P[bg]};
			  --card-bg-color: ${P[panel]};
			  --card-fg-color: ${P[ink]};
			  --dialog-bg-color: ${P[panel]};
			  --dialog-fg-color: ${P[ink]};
			  --popover-bg-color: ${P[panel]};
			  --popover-fg-color: ${P[ink]};
			  --thumbnail-bg-color: ${P[panel]};
			  --border-color: ${P[line]};
			}
		EOF
	} | own "$CONFIG_HOME/gtk-4.0/gtk.css"

	local ver
	for ver in 3.0 4.0; do
		own "$CONFIG_HOME/gtk-$ver/settings.ini" <<-EOF
			$MARK
			[Settings]
			gtk-theme-name=$(gtk_theme)
			gtk-icon-theme-name=$(icon_theme)
			gtk-font-name=$font $font_size
			gtk-cursor-theme-name=Adwaita
			gtk-cursor-theme-size=24
			gtk-decoration-layout=$(decoration_layout)
		EOF
	done
}

write_xsettingsd() {
	local f=$CONFIG_HOME/xsettingsd/xsettingsd.conf theme=${1:-$(gtk_theme)}
	own "$f" <<-EOF
		$MARK
		Net/ThemeName "$theme"
		Net/IconThemeName "$(icon_theme)"
		Gtk/FontName "$font $font_size"
		Gtk/MonospaceFontName "$mono_font $font_size"
		Gtk/CursorThemeName "Adwaita"
		Gtk/CursorThemeSize 24
		Gtk/DecorationLayout "$(decoration_layout)"
		Net/EnableEventSounds 0
		Xft/Antialias 1
		Xft/Hinting 1
		Xft/HintStyle "hintslight"
		Xft/RGBA "rgb"
	EOF
}

# Running GTK 3 apps re-read gtk.css only when the theme name changes, so
# briefly switch to plain Adwaita and back. Harmless when xsettingsd is off.
# Running GTK apps reload their theme when its name changes. A light/dark
# switch changes the name anyway; for other changes (accent, corners) the
# name is briefly set to Adwaita so apps re-read gtk.css. The pause is long
# enough that every app sees both steps: some (Firefox, Thunderbird) skip
# changes that come too fast and would stay on the light Adwaita theme.
reload_gtk_live() {
	pgrep -x xsettingsd >/dev/null 2>&1 || return 0
	if [[ -n ${PREV_GTK_THEME:-} && $PREV_GTK_THEME == "$(gtk_theme)" ]]; then
		write_xsettingsd Adwaita
		pkill -HUP -x xsettingsd || true
		sleep 0.6
	fi
	write_xsettingsd
	pkill -HUP -x xsettingsd || true
}

# libadwaita (GTK 4) apps and browsers learn light/dark and the accent through
# the settings portal, which xdg-desktop-portal-gtk reads from gsettings.
write_gsettings() {
	has gsettings || return 0
	local schema=org.gnome.desktop.interface scheme=prefer-light gaccent
	[[ $mode != light ]] && scheme=prefer-dark
	# GNOME's accents: blue teal green yellow orange red pink purple slate
	case $accent in
		violet | indigo) gaccent=purple ;; fuchsia) gaccent=pink ;; amber) gaccent=yellow ;;
		lime) gaccent=green ;; cyan) gaccent=teal ;; sky) gaccent=blue ;; mono) gaccent=slate ;;
		*) gaccent=$accent ;;
	esac
	{
		gsettings set $schema color-scheme "$scheme"
		gsettings set $schema gtk-theme "$(gtk_theme)"
		gsettings set $schema icon-theme "$(icon_theme)"
		gsettings set $schema font-name "$font $font_size"
		gsettings set $schema monospace-font-name "$mono_font $font_size"
		gsettings set $schema cursor-theme Adwaita
		gsettings set org.gnome.desktop.wm.preferences button-layout "$(decoration_layout)"
		if gsettings range $schema accent-color >/dev/null 2>&1; then
			gsettings set $schema accent-color "$gaccent"
		fi
	} 2>/dev/null || true
}

# ---------------------------------------------------------------- Qt
# KDE apps (Dolphin, Kate, ...) colour parts of their UI from kdeglobals
# rather than the Qt palette, so mirror the palette there too.
write_kdeglobals() {
	local sec bgn bga fgn
	{
		echo "$MARK"
		echo "[General]"
		echo "ColorScheme=Lumen"
		echo "AccentColor=$(rgb "${P[accent]}")"
		echo
		echo "[Icons]"
		echo "Theme=$(icon_theme)"
		for sec in View Window Button Header Complementary Tooltip Selection; do
			case $sec in
				View) bgn=panel bga=field fgn=ink ;;
				Window | Header | Complementary) bgn=bg bga=field fgn=ink ;;
				Button) bgn=field bga=panel fgn=ink ;;
				Tooltip) bgn=ink bga=ink fgn=bg ;;
				Selection) bgn=accent bga=accent fgn=on_accent ;;
			esac
			echo
			echo "[Colors:$sec]"
			echo "BackgroundNormal=$(rgb "${P[$bgn]}")"
			echo "BackgroundAlternate=$(rgb "${P[$bga]}")"
			echo "ForegroundNormal=$(rgb "${P[$fgn]}")"
			if [[ $sec == Selection || $sec == Tooltip ]]; then
				echo "ForegroundInactive=$(rgb "${P[$fgn]}")"
				echo "ForegroundActive=$(rgb "${P[$fgn]}")"
			else
				echo "ForegroundInactive=$(rgb "${P[muted]}")"
				echo "ForegroundActive=$(rgb "${P[accent]}")"
			fi
			echo "ForegroundLink=$(rgb "${P[accent]}")"
			echo "ForegroundVisited=$(rgb "${P[accent]}")"
			echo "ForegroundNegative=$(rgb "${P[danger]}")"
			echo "ForegroundNeutral=$(rgb "${P[warning]}")"
			echo "ForegroundPositive=$(rgb "${P[success]}")"
			echo "DecorationFocus=$(rgb "${P[accent]}")"
			echo "DecorationHover=$(rgb "${P[accent]}")"
		done
	} | own "$CONFIG_HOME/kdeglobals"
}

# ---------------------------------------------------------------- others
write_kitty() {
	local i
	{
		echo "$MARK"
		echo "foreground ${P[ink]}"
		echo "background ${P[bg]}"
		echo "selection_foreground ${P[on_accent]}"
		echo "selection_background ${P[accent]}"
		echo "cursor ${P[accent]}"
		echo "cursor_text_color ${P[bg]}"
		echo "url_color ${P[accent]}"
		echo "active_border_color ${P[accent]}"
		echo "inactive_border_color ${P[line]}"
		echo "active_tab_foreground ${P[on_accent]}"
		echo "active_tab_background ${P[accent]}"
		echo "inactive_tab_foreground ${P[muted]}"
		echo "inactive_tab_background ${P[field]}"
		echo "tab_bar_background ${P[bg]}"
		for i in {0..15}; do echo "color$i ${P[color$i]}"; done
	} | own "$CONFIG_HOME/kitty/theme.conf"
	pkill -USR1 -x kitty 2>/dev/null || true # kitty reloads its config on SIGUSR1
}

# The login screen (values quoted: QSettings treats a bare # as a comment).
# The installer makes theme.conf.user owned by you, so
# this needs no root. SDDM reads it the next time the login screen starts.
SDDM_USER_CONF=/usr/share/sddm/themes/lumen/theme.conf.user
write_sddm() {
	[[ -w $SDDM_USER_CONF ]] || return 0
	cat >"$SDDM_USER_CONF" <<-EOF
		$MARK
		[General]
		mode="$mode"
		bg="${P[bg]}"
		panel="${P[panel]}"
		field="${P[field]}"
		ink="${P[ink]}"
		muted="${P[muted]}"
		line="${P[line]}"
		accent="${P[accent]}"
		on_accent="${P[on_accent]}"
		danger="${P[danger]}"
		font="$font"
		corners="$corners"
	EOF
}

apply_bspwm() {
	has bspc && bspc query -M >/dev/null 2>&1 || return 0
	bspc config normal_border_color "${P[line]}"
	bspc config active_border_color "${P[line]}"
	bspc config focused_border_color "${P[accent]}"
	bspc config presel_feedback_color "${P[accent]}"
}

apply_root() {
	[[ -n ${DISPLAY:-} ]] || return 0
	# picom only draws a background that's published as a root pixmap, which
	# hsetroot does; plain xsetroot would leave the desktop black under picom.
	if has hsetroot; then
		# Wallpaper from Settings > Wallpaper, over the theme colour.
		local how=""
		case $wallpaper_mode in
			fill) how=-cover ;; fit) how=-full ;; center) how=-center ;;
			tile) how=-tile ;; stretch) how=-fill ;;
		esac
		if [[ -n $wallpaper && -r $wallpaper && -n $how ]]; then
			hsetroot -solid "${P[bg]}" "$how" "$wallpaper" >/dev/null 2>&1 ||
				hsetroot -solid "${P[bg]}" >/dev/null 2>&1 || true
		else
			hsetroot -solid "${P[bg]}" >/dev/null 2>&1 || true
		fi
	elif has xsetroot; then
		xsetroot -solid "${P[bg]}" 2>/dev/null || true
	fi
}

apply() {
	load_settings
	load_palette
	# The theme name running apps have now, to tell whether it changes.
	PREV_GTK_THEME=$(sed -n 's/^Net\/ThemeName "\(.*\)"$/\1/p' "$CONFIG_HOME/xsettingsd/xsettingsd.conf" 2>/dev/null || true)
	write_gtk
	write_xsettingsd
	write_gsettings
	write_kdeglobals
	write_kitty
	write_sddm
	write_other_apps
	apply_bspwm
	apply_root
	reload_gtk_live
	say "applied $accent / $mode"
}

# ---------------------------------------------------------------- CLI
# Settings are stored by lumen-settings; these commands are shortcuts to it.
SETTINGS_BIN=$(dirname "$(readlink -f "$0")")/lumen-settings
[[ -x $SETTINGS_BIN ]] || SETTINGS_BIN=lumen-settings

cmd=${1:-apply}
shift || true
case $cmd in
	apply)
		[[ ${1:-} == --quiet ]] && QUIET=1
		apply
		;;
	set) exec "$SETTINGS_BIN" set "$@" ;;
	get) exec "$SETTINGS_BIN" get "$@" ;;
	icon-theme) load_settings; icon_theme; echo ;;   # for QS_ICON_THEME
	toggle-mode)
		load_settings
		[[ $mode != light ]] && next=light || next=dark
		exec "$SETTINGS_BIN" set mode "$next"
		;;
	cycle-accent)
		load_settings
		next=blue
		for i in "${!ACCENTS[@]}"; do
			[[ ${ACCENTS[$i]} == "$accent" ]] && { next=${ACCENTS[$(((i + 1) % ${#ACCENTS[@]}))]}; break; }
		done
		exec "$SETTINGS_BIN" set accent "$next"
		;;
	list)
		echo "mode: ${MODES[*]}"
		echo "accent: ${ACCENTS[*]}"
		echo "bar_position: ${POSITIONS[*]}"
		;;
	-h | --help | help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command: $cmd (try --help)" ;;
esac

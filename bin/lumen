#!/bin/sh
# lumen — open parts of the desktop from a terminal or a shortcut.
#
#   lumen settings [page]   Settings (pages: network bluetooth appearance wallpaper
#                           bar display sound input notifications performance
#                           datetime users about)
#   lumen launcher          app launcher
#   lumen shortcuts         keyboard shortcuts
#   lumen clipboard         clipboard history
#   lumen files [folder]    file manager (your default one, Thunar unless changed)
#   lumen lock              lock the screen
#   lumen reload            restart the bar and popups (after updating lumen)
#   lumen theme ...         same as lumen-theme (e.g. lumen theme set mode light)
#   lumen debug             sizes of the bar's parts, for bug reports
#   lumen doctor            check what lumen depends on (for bug reports)
set -eu

ipc() { qs_ok; exec qs -c lumen ipc call "$@"; }

# Quickshell uses Qt's private API, so it has to be built against the exact Qt
# version installed. After a Qt update it fails at once with "symbol lookup
# error ... Qt_6_PRIVATE_API" until it's rebuilt; say what to do instead.
qs_ok() {
	local out
	out=$(qs --version 2>&1) && return 0
	case $out in
		*"symbol lookup error"*Qt_6_PRIVATE_API*)
			echo "lumen: Quickshell was built for a different Qt version than the one installed." >&2
			echo "       Update everything (sudo pacman -Syu); if that doesn't help, Quickshell needs" >&2
			echo "       a rebuild for this Qt (see 'Quickshell won't start' in the README)." >&2
			exit 1 ;;
	esac
	return 0
}

case ${1:-help} in
	settings) [ -n "${2:-}" ] && ipc settings open "$2" || ipc settings show ;;
	launcher) ipc launcher toggle ;;
	shortcuts) ipc shortcuts toggle ;;
	clipboard) ipc clipboard toggle ;;
	files)
		dir=${2:-$HOME}
		gio open "$dir" 2>/dev/null || exec thunar "$dir"
		;;
	lock) exec lumen-lock ;;
	reload)
		qs_ok
		qs -c lumen kill >/dev/null 2>&1 || qs kill -c lumen >/dev/null 2>&1 || true
		sleep 0.3
		state=${XDG_STATE_HOME:-$HOME/.local/state}/lumen
		mkdir -p "$state"
		QS_ICON_THEME=$(lumen-theme icon-theme 2>/dev/null) setsid -f qs -c lumen >"$state/quickshell.log" 2>&1
		echo "lumen: restarted (log: $state/quickshell.log)"
		;;
	theme) shift; exec lumen-theme "$@" ;;
	debug) ipc debug bar ;;
	doctor) exec lumen-doctor ;;
	-h | --help | help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) echo "lumen: unknown command: $1 (try: lumen help)" >&2; exit 1 ;;
esac

#!/usr/bin/env bash
# lumen-capture — screenshots and screen recordings.
#
# Usage:
#   lumen-capture shot <screen|window|selection> [--delay N] [--no-copy]
#   lumen-capture record <screen|window|selection> [--audio] [--no-cursor]
#   lumen-capture stop             stop the recording
#   lumen-capture toggle <target>  start recording, or stop if one is running
#   lumen-capture status           "recording <start-epoch> <file>" or "idle"
#
# Screenshots go to ~/Pictures/Screenshots (and the clipboard); recordings to
# ~/Videos/Recordings. "window" is the focused window, "selection" lets you
# drag a rectangle or click a window. Uses maim, slop, xclip and
# gpu-screen-recorder, which falls back to CPU encoding (e.g. in a VM).
set -uo pipefail

PICS=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
VIDS=$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Recordings
RUN=${XDG_RUNTIME_DIR:-/tmp}/lumen-recording
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/lumen/recording.log

die() { printf 'lumen-capture: %s\n' "$*" >&2; notify-send -a lumen -u low "Capture" "$*" 2>/dev/null; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }
stamp() { date +%Y-%m-%d_%H-%M-%S; }
# A file name that doesn't exist yet: name.ext, name-2.ext, ...
unique() {
	local base=$1 ext=$2 n=2 f="$1.$2"
	while [[ -e $f ]]; do f="$base-$n.$ext"; n=$((n + 1)); done
	printf '%s' "$f"
}
notify_shell() { has qs && { qs -c lumen ipc call capture changed >/dev/null 2>&1 & } || true; }

# Focused window id (bspwm node ids are X window ids), as decimal.
focused_window() {
	local id
	id=$(bspc query -N -n focused.window 2>/dev/null) || return 1
	[[ -n $id ]] && printf '%d' "$id"
}

# Region WxH+X+Y chosen with the mouse (drag, or click a window).
select_region() {
	has slop || die "slop is not installed"
	slop -f '%wx%h+%x+%y' -b 2 -l -c 0.45,0.64,1,0.18 2>/dev/null
}

recording() { [[ -f $RUN ]] && kill -0 "$(cut -d' ' -f1 "$RUN")" 2>/dev/null; }

shot() {
	local target=${1:-screen} delay=0 copy=1 file args=()
	shift || true
	while (($#)); do
		case $1 in
			--delay) delay=${2:-0}; shift ;;
			--no-copy) copy=0 ;;
		esac
		shift
	done
	[[ $delay =~ ^[0-9]+$ ]] || die "invalid delay"
	has maim || die "maim is not installed"
	mkdir -p "$PICS"
	file=$(unique "$PICS/Screenshot_$(stamp)" png)

	case $target in
		screen) ;;
		window) local w; w=$(focused_window) || die "no focused window"; args+=(-i "$w") ;;
		selection) local r; r=$(select_region) || exit 0; [[ -n $r ]] || exit 0; args+=(-g "$r") ;;
		*) die "unknown target: $target (screen, window, selection)" ;;
	esac

	sleep "0.25" # let the capture panel disappear
	((delay > 0)) && sleep "$delay"
	maim -u "${args[@]}" "$file" 2>/dev/null || die "screenshot failed"
	((copy)) && has xclip && xclip -selection clipboard -t image/png -i "$file"
	notify-send -a lumen -i "$file" "Screenshot saved" "${file/#$HOME/\~}$( ((copy)) && echo ' · copied to the clipboard')" 2>/dev/null
	printf '%s\n' "$file"
}

record() {
	local target=${1:-screen} audio=0 cursor=yes file wargs=()
	shift || true
	while (($#)); do
		case $1 in
			--audio) audio=1 ;;
			--no-cursor) cursor=no ;;
		esac
		shift
	done
	recording && die "already recording (lumen-capture stop)"
	has gpu-screen-recorder || die "gpu-screen-recorder is not installed"
	mkdir -p "$VIDS" "$(dirname "$LOG")"
	file=$(unique "$VIDS/Recording_$(stamp)" mp4)

	case $target in
		screen) wargs=(-w screen) ;;
		window) wargs=(-w focused) ;;
		selection)
			local r; r=$(select_region) || exit 0; [[ -n $r ]] || exit 0
			# Encoders need even sizes.
			local w=${r%%x*} rest=${r#*x}; local h=${rest%%+*} pos=${rest#*+}
			r="$((w / 2 * 2))x$((h / 2 * 2))+$pos"
			wargs=(-w region -region "$r")
			;;
		*) die "unknown target: $target (screen, window, selection)" ;;
	esac

	sleep 0.25
	local cmd=(gpu-screen-recorder "${wargs[@]}" -f 60 -cursor "$cursor" -fallback-cpu-encoding yes -o "$file")
	((audio)) && cmd+=(-a default_output)
	"${cmd[@]}" >"$LOG" 2>&1 &
	local pid=$!
	sleep 0.6
	kill -0 "$pid" 2>/dev/null || die "recording failed to start (see ${LOG/#$HOME/\~})"
	printf '%s %s %s\n' "$pid" "$(date +%s)" "$file" >"$RUN"
	notify_shell
}

stop() {
	recording || { rm -f "$RUN"; notify_shell; return 0; }
	local pid start file
	read -r pid start file <"$RUN"
	kill -INT "$pid" 2>/dev/null
	for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
	rm -f "$RUN"
	notify_shell
	notify-send -a lumen "Recording saved" "${file/#$HOME/\~}" 2>/dev/null
	printf '%s\n' "$file"
}

case ${1:-} in
	shot) shift; shot "$@" ;;
	record) shift; record "$@" ;;
	stop) stop ;;
	toggle) shift; if recording; then stop; else record "$@"; fi ;;
	status)
		if recording; then
			read -r _ start file <"$RUN"
			printf 'recording %s %s\n' "$start" "$file"
		else
			rm -f "$RUN"
			echo idle
		fi
		;;
	*) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; [[ -z ${1:-} || $1 == -h || $1 == --help ]] ;;
esac

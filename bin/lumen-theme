colors = "".join("%s: %s;\n" % kv for kv in c.items())

# A one-pixel tiled background in the window colour (no chat pattern).
def png1(color):
    raw = b"\x00" + bytes(rgb(color))
    def chunk(t, d): return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))

with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    z.writestr("colors.tdesktop-theme", "// Generated by lumen-theme\n" + colors)
    z.writestr("tiled.png", png1(bg))
PY
}

telegram_open() {
	[[ -f $TELEGRAM_THEME ]] || die "no Telegram theme yet: turn it on in Settings > Appearance > Other apps"
	local b
	for b in telegram-desktop Telegram telegram; do
		has "$b" && { setsid -f "$b" -- "$TELEGRAM_THEME" >/dev/null 2>&1; return 0; }
	done
	has flatpak && flatpak info org.telegram.desktop >/dev/null 2>&1 &&
		{ setsid -f flatpak run --file-forwarding org.telegram.desktop -- @@ "$TELEGRAM_THEME" @@ >/dev/null 2>&1; return 0; }
	xdg-open "$TELEGRAM_THEME" >/dev/null 2>&1 || die "Telegram Desktop isn't installed"
}

# "38;2;R;G;B": a 24-bit ANSI colour, which fastfetch takes as is.
ansi_rgb() { local h=${1#\#}; printf '38;2;%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

# A file lumen wrote replaces yours while the theme is on; yours comes back
# (from .pre-lumen) when it's turned off.
disown_file() {
	local f=$1
	[[ -f $f ]] && grep -qF "lumen-theme" "$f" || return 0
	if [[ -f $f.pre-lumen ]]; then mv -f "$f.pre-lumen" "$f"; else rm -f "$f"; fi
}

# foot was themed briefly; remove what that wrote.
cleanup_foot() {
	local ini=$CONFIG_HOME/foot/foot.ini
	local begin="# lumen start (generated by lumen-theme)" end="# lumen end"
	if [[ -f $ini ]] && grep -qxF "$begin" "$ini"; then
		awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$ini" >"$ini.lumen-tmp" &&
			mv "$ini.lumen-tmp" "$ini"
	fi
	disown_file "$CONFIG_HOME/foot/lumen.ini"
}

# fish: syntax highlighting, completions pager and prompt colours, as
# global variables in ~/.config/fish/conf.d/lumen.fish (they win over your
# universal ones while the theme is on; nothing of yours is changed). New fish
# windows pick it up; in an open one: source ~/.config/fish/conf.d/lumen.fish
write_fish() {
	local f=$CONFIG_HOME/fish/conf.d/lumen.fish
	if [[ ${theme_fish:-false} != true ]]; then
		disown_file "$f"
		return 0
	fi
	fish_hex() { local c=${P[$1]}; printf '%s' "${c#\#}"; }
	own "$f" <<EOF
# Generated by lumen-theme ($accent, $mode). Turn it off in Settings >
# Appearance > Other apps; your own fish colours come back.
status is-interactive; or return
set -g fish_color_normal $(fish_hex ink)
set -g fish_color_command $(fish_hex accent)
set -g fish_color_keyword $(fish_hex color5)
set -g fish_color_quote $(fish_hex color2)
set -g fish_color_redirection $(fish_hex color6)
set -g fish_color_end $(fish_hex color13)
set -g fish_color_error $(fish_hex danger)
set -g fish_color_param $(fish_hex ink)
set -g fish_color_option $(fish_hex color12)
set -g fish_color_valid_path --underline
set -g fish_color_comment $(fish_hex muted) --italics
set -g fish_color_operator $(fish_hex color6)
set -g fish_color_escape $(fish_hex color14)
set -g fish_color_autosuggestion $(fish_hex color8)
set -g fish_color_selection $(fish_hex on_accent) --background=$(fish_hex accent)
set -g fish_color_search_match --background=$(fish_hex field)
set -g fish_color_history_current --bold
set -g fish_color_cancel --reverse
set -g fish_color_user $(fish_hex accent)
set -g fish_color_host $(fish_hex ink)
set -g fish_color_host_remote $(fish_hex warning)
set -g fish_color_cwd $(fish_hex accent)
set -g fish_color_cwd_root $(fish_hex danger)
set -g fish_color_status $(fish_hex danger)
set -g fish_pager_color_prefix $(fish_hex accent) --bold --underline
set -g fish_pager_color_completion $(fish_hex ink)
set -g fish_pager_color_description $(fish_hex muted)
set -g fish_pager_color_progress $(fish_hex on_accent) --background=$(fish_hex accent)
set -g fish_pager_color_selected_background --background=$(fish_hex field)
set -g fish_pager_color_selected_prefix $(fish_hex accent) --bold --underline
set -g fish_pager_color_selected_completion $(fish_hex ink) --bold
set -g fish_pager_color_selected_description $(fish_hex ink)
EOF
}

# fastfetch: lumen's own layout (the lumen logo, details grouped under
# system / desktop / hardware) in the theme colours. Your config, if you had
# one, is kept as config.jsonc.pre-lumen and comes back when this is off.
write_fastfetch() {
	local dir=$CONFIG_HOME/fastfetch f=$CONFIG_HOME/fastfetch/config.jsonc logo=$CONFIG_HOME/fastfetch/lumen-logo.txt
	if [[ ${theme_fastfetch:-false} != true ]]; then
		disown_file "$f"
		rm -f "$logo"
		return 0
	fi
	mkdir -p "$dir"
	local src=$DATA_HOME/lumen/fastfetch/lumen-logo.txt
	[[ -f $src ]] || src=$REPO_SHARE/fastfetch/lumen-logo.txt
	[[ -f $src ]] && cp -f "$src" "$logo"
	local acc ink muted line
	acc=$(ansi_rgb "${P[accent]}") ink=$(ansi_rgb "${P[ink]}") muted=$(ansi_rgb "${P[muted]}") line=$(ansi_rgb "${P[line]}")
	# A section heading: a label and a rule.
	ff_section() { printf '    { "type": "custom", "format": "%s", "outputColor": "%s" },' "$1" "$acc"; }
	own "$f" <<EOF
// Generated by lumen-theme ($accent, $mode). Your own config, if you had one,
// is config.jsonc.pre-lumen and comes back when the fastfetch theme is off.
{
  "\$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "$logo",
    "color": { "1": "$acc", "2": "$ink" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "   ",
    "color": { "keys": "$muted", "title": "$acc", "output": "$ink", "separator": "$line" },
    "key": { "width": 12 },
    "percent": { "type": 3 },
    "bar": { "charElapsed": "■", "charTotal": "·", "width": 12 }
  },
  "modules": [
    { "type": "title", "color": { "user": "$acc", "at": "$muted", "host": "$ink" } },
    "break",
$(ff_section "system ──────────────────────────────")
    { "type": "os", "key": "  os" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "uptime", "key": "  uptime" },
    { "type": "packages", "key": "  packages" },
    { "type": "shell", "key": "  shell" },
    "break",
$(ff_section "desktop ─────────────────────────────")
    { "type": "wm", "key": "  wm" },
    { "type": "command", "key": "  theme", "text": "echo 'lumen  ·  $accent, $mode'" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "font", "key": "  font" },
    { "type": "display", "key": "  display" },
    "break",
$(ff_section "hardware ────────────────────────────")
    { "type": "cpu", "key": "  cpu" },
    { "type": "gpu", "key": "  gpu" },
    { "type": "memory", "key": "  memory" },
    { "type": "disk", "key": "  disk", "folders": "/" },
    { "type": "battery", "key": "  battery" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
EOF
}

# Heroic Games Launcher: a custom theme (lumen.css) in a folder Heroic is
# pointed to (Settings > Accessibility > Custom themes path). Pick "lumen"
# there once; after a colour change, pick it again to reload it.
HEROIC_THEMES=$DATA_HOME/lumen/heroic
write_heroic() {
	local conf c
	if [[ ${theme_heroic:-false} != true ]]; then
		rm -rf "$HEROIC_THEMES"
		return 0
	fi
	mkdir -p "$HEROIC_THEMES"
	cat >"$HEROIC_THEMES/lumen.css" <<EOF
/* Generated by lumen-theme ($accent, $mode). */
body.lumen {
  --text-default: ${P[ink]};
  --text-secondary: ${P[muted]};
  --text-tertiary: ${P[deep]};
  --background: ${P[bg]};
  --background-darker: ${P[deep]};
  --background-lighter: ${P[panel]};
  --body-background: ${P[bg]};
  --gradient-body-background: ${P[bg]};
  --current-background: ${P[bg]};
  --input-background: ${P[field]};
  --controller-hints-background: transparent;
  --modal-background: ${P[panel]};
  --modal-border: ${P[line]};
  --osk-background: ${P[bg]};
  --osk-button-background: ${P[field]};
  --osk-button-border: ${P[line]};
  --search-bar-background: ${P[field]};
  --search-bar-border: ${P[line]};
  --action-icon: ${P[ink]};
  --action-icon-hover: ${P[accent]};
  --action-icon-active: ${P[accent]};
  --icons-background: ${P[bg]};
  --brand-primary: ${P[accent]};
  --brand-primary-hover: ${P[accent]};
  --primary-button: ${P[accent]};
  --primary-button-overlay: ${P[accent]};
  --secondary-button: ${P[accent]};
  --secondary-button-overlay: ${P[accent]};
  --tertiary-button: ${P[accent]};
  --tertiary-button-overlay: ${P[accent]};
  --success-button: ${P[success]};
  --disabled-button: ${P[field]};
  --disabled-button-overlay: ${P[line]};
  --navbar-active: ${P[accent]};
  --navbar-inactive: ${P[muted]};
  --navbar-active-background: ${P[field]};
  --navbar-accent: ${P[accent]};
  --navbar-background: ${P[panel]};
  --divider: ${P[line]};
  --success: ${P[success]};
  --success-hover: ${P[success]};
  --danger: ${P[danger]};
  --danger-hover: ${P[danger]};
  --primary: ${P[accent]};
  --secondary: ${P[accent]};
  --accent: ${P[accent]};
  --status-success: ${P[success]};
  --status-warning: ${P[warning]};
  --status-danger: ${P[danger]};
  --status-info: ${P[accent]};
  --neutral-01: ${P[deep]};
  --neutral-02: ${P[bg]};
  --neutral-03: ${P[field]};
  --neutral-04: ${P[line]};
  --neutral-05: ${P[muted]};
  --neutral-06: ${P[ink]};
}
body.lumen select, body.lumen input { box-shadow: none; }
EOF
	# Point Heroic at the folder (native and Flatpak installs), unless it
	# already points somewhere else.
	has python3 || return 0
	for conf in "$CONFIG_HOME/heroic/config.json" "$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic/config.json"; do
		[[ -f $conf ]] || continue
		python3 - "$conf" "$HEROIC_THEMES" <<'PY' || true
import json, sys
path, folder = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
d = data.setdefault("defaultSettings", {})
if d.get("customThemesPath") in (None, "", folder):
    d["customThemesPath"] = folder
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
PY
	done
}

